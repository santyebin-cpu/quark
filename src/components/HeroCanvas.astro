---
/**
 * Lightweight canvas stand-in for a WebGL hero: a field of "quarks" bound in
 * drifting triplets, drawn over a slow radial glow. No dependencies.
 */
---

<canvas class="heroCanvas" data-hero-canvas aria-hidden="true"></canvas>

<style>
  .heroCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    let w = 0;
    let h = 0;
    let dpr = 1;
    let t = 0;
    let raf = 0;
    let pointer = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5 };

    type Triplet = {
      x: number;
      y: number;
      r: number;
      spin: number;
      phase: number;
      drift: number;
      size: number;
      alpha: number;
    };

    let triplets: Triplet[] = [];

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
    }

    function seed() {
      const count = Math.round(Math.min(26, Math.max(10, (w * h) / 60000)));
      triplets = Array.from({ length: count }, (_, i) => ({
        x: Math.random(),
        y: Math.random(),
        r: 14 + Math.random() * 34,
        spin: (Math.random() > 0.5 ? 1 : -1) * (0.2 + Math.random() * 0.5),
        phase: Math.random() * Math.PI * 2,
        drift: 0.4 + Math.random() * 0.8,
        size: 1.2 + Math.random() * 1.8,
        alpha: 0.25 + Math.random() * 0.55,
      }));
    }

    function draw() {
      t += reduced ? 0 : 0.008;
      pointer.x += (pointer.tx - pointer.x) * 0.04;
      pointer.y += (pointer.ty - pointer.y) * 0.04;

      ctx.clearRect(0, 0, w, h);

      // Glow
      const gx = w * (0.5 + (pointer.x - 0.5) * 0.25);
      const gy = h * (0.62 + (pointer.y - 0.5) * 0.15);
      const g = ctx.createRadialGradient(gx, gy, 0, gx, gy, Math.max(w, h) * 0.75);
      g.addColorStop(0, 'rgba(79,125,249,0.42)');
      g.addColorStop(0.35, 'rgba(79,125,249,0.14)');
      g.addColorStop(0.7, 'rgba(143,211,255,0.04)');
      g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, w, h);

      // Horizon ring
      ctx.save();
      ctx.translate(w / 2, h * 1.08);
      ctx.scale(1, 0.32);
      for (let i = 0; i < 4; i++) {
        const rr = w * (0.45 + i * 0.16) + Math.sin(t * 1.3 + i) * 6;
        ctx.beginPath();
        ctx.arc(0, 0, rr, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(255,255,255,${0.12 - i * 0.025})`;
        ctx.lineWidth = 1;
        ctx.stroke();
      }
      ctx.restore();

      // Quark triplets
      for (const q of triplets) {
        const cx = (q.x + Math.sin(t * q.drift + q.phase) * 0.02 + (pointer.x - 0.5) * 0.03 * q.drift) * w;
        const cy = (q.y + Math.cos(t * q.drift * 0.8 + q.phase) * 0.02 + (pointer.y - 0.5) * 0.03 * q.drift) * h;
        const pts: [number, number][] = [];
        for (let k = 0; k < 3; k++) {
          const a = q.phase + t * q.spin + (k * Math.PI * 2) / 3;
          pts.push([cx + Math.cos(a) * q.r, cy + Math.sin(a) * q.r * 0.75]);
        }
        ctx.beginPath();
        ctx.moveTo(pts[0][0], pts[0][1]);
        ctx.lineTo(pts[1][0], pts[1][1]);
        ctx.lineTo(pts[2][0], pts[2][1]);
        ctx.closePath();
        ctx.strokeStyle = `rgba(255,255,255,${q.alpha * 0.28})`;
        ctx.lineWidth = 0.8;
        ctx.stroke();

        for (const [px, py] of pts) {
          ctx.beginPath();
          ctx.arc(px, py, q.size, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255,255,255,${q.alpha})`;
          ctx.fill();
        }
      }

      if (!reduced) raf = requestAnimationFrame(draw);
    }

    window.addEventListener('resize', resize);
    window.addEventListener(
      'pointermove',
      (e) => {
        pointer.tx = e.clientX / window.innerWidth;
        pointer.ty = e.clientY / window.innerHeight;
      },
      { passive: true },
    );

    // Pause when offscreen
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          cancelAnimationFrame(raf);
          draw();
        } else {
          cancelAnimationFrame(raf);
        }
      },
      { threshold: 0 },
    );

    resize();
    io.observe(canvas);
  }
</script>
