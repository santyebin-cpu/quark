---
interface Props {
  icon: string;
  label: string;
  value: string;
  note?: string;
  index?: number;
}
const { icon, label, value, note, index = 0 } = Astro.props;
---

<li class="stat reveal" style={`--delay:${(index % 3) * 90}ms`}>
  <div class="stat__inner">
    <div class="stat__top">
      <svg class="stat__icon" aria-hidden="true"><use href={`#${icon}`} /></svg>
      <p class="textSmall stat__label">{label}</p>
    </div>
    <div class="stat__bottom">
      <p class="stat__value">{value}</p>
      {note && <p class="stat__note">{note}</p>}
    </div>
  </div>
</li>

<style>
  .stat {
    border-top: 1px solid var(--color-line);
    min-height: 22rem;
  }

  @media (min-width: 900px) {
    .stat {
      min-height: 28rem;
    }
  }

  .stat__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: 2rem 0 3rem;
  }

  .stat__top {
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
  }

  .stat__icon {
    width: 4.4rem;
    height: 4.4rem;
    color: var(--color-ink);
  }

  .stat__label {
    color: var(--color-grey-on-white);
    max-width: 18rem;
  }

  .stat__bottom {
    margin-top: 3rem;
  }

  .stat__value {
    font-size: 2.6rem;
    letter-spacing: -0.05rem;
    line-height: 1.05;
  }

  @media (min-width: 900px) {
    .stat__value {
      font-size: 3.2rem;
    }
  }

  .stat__note {
    margin-top: 0.8rem;
    color: var(--color-grey-on-white);
    font-size: 1.3rem;
  }
</style>
