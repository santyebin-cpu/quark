    </symbol>
    <symbol id="icon-stat-cost" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
      <circle cx="24" cy="24" r="16" />
      <path d="M24 14v20M29 18c0-2-2-3-5-3s-5 1-5 3.5 2 3 5 3.5 5 1.5 5 3.5-2 3.5-5 3.5-5-1-5-3" />
    </symbol>
    <symbol id="icon-stat-safety" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M24 6 10 11v12c0 9 6 15 14 19 8-4 14-10 14-19V11L24 6Z" />
      <path d="m17 24 5 5 9-10" />
    </symbol>
    <symbol id="icon-stat-footprint" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M8 16 24 8l16 8-16 8-16-8Z" />
      <path d="m8 24 16 8 16-8M8 32l16 8 16-8" />
    </symbol>
    <symbol id="icon-stat-life" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
      <circle cx="24" cy="24" r="16" />
      <path d="M24 12v12l8 5" />
    </symbol>
  </defs>
</svg>
