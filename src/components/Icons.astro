---
/** Inline SVG sprite. Reference with <svg><use href="#icon-name" /></svg>. */
---

<svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden" focusable="false">
  <defs>
    <symbol id="icon-arrow-top-right" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" />
    </symbol>
    <symbol id="icon-arrow-down" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M6 1v10M1.5 6.5 6 11l4.5-4.5" />
    </symbol>
    <symbol id="icon-arrow-right" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M1 6h10M6.5 1.5 11 6l-4.5 4.5" />
    </symbol>
    <symbol id="icon-plus" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M6 1v10M1 6h10" />
    </symbol>
    <symbol id="icon-close" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M2 2l8 8M10 2l-8 8" />
    </symbol>
    <symbol id="icon-circle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10" />
    </symbol>
    <symbol id="icon-linkedin" viewBox="0 0 24 24">
      <path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.5c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21h-4V9Z" />
    </symbol>
    <symbol id="icon-x" viewBox="0 0 24 24">
      <path d="M17.5 3h3.1l-6.8 7.8L21.8 21h-6.3l-4.9-6.4L5 21H1.9l7.3-8.3L1.5 3H8l4.4 5.9L17.5 3Zm-1.1 16.2h1.7L7 4.7H5.2l11.2 14.5Z" />
    </symbol>

    <!-- Stat icons -->
    <symbol id="icon-stat-homes" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M8 24 24 10l16 14M12 21v17h24V21" />
      <path d="M20 38V28h8v10" />
    </symbol>
    <symbol id="icon-stat-modules" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
      <rect x="8" y="8" width="14" height="14" rx="2" />
      <rect x="26" y="8" width="14" height="14" rx="2" />
      <rect x="8" y="26" width="14" height="14" rx="2" />
      <rect x="26" y="26" width="14" height="14" rx="2" stroke-dasharray="2 2" />
    </symbol>
    <symbol id="icon-stat-fuel" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
      <circle cx="24" cy="24" r="16" />
      <circle cx="24" cy="24" r="4" />
      <path d="M24 8v12M24 28v12M8 24h12M28 24h12" />
    </symbol>
    <symbol id="icon-stat-waste" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M12 14h24l-2 26H14l-2-26ZM18 14V9h12v5M20 20v14M28 20v14" />
    </symbol>
    <symbol id="icon-stat-heat" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M16 36c-6-6-4-14 2-18 0 6 4 8 4 8s2-14 10-18c-2 8 6 10 6 18 0 6-4 12-11 12s-9-2-11-2Z" />
    </symbol>
    <symbol id="icon-stat-pressure" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M8 30a16 16 0 0 1 32 0" />
      <path d="M24 30 32 18M20 30h8" />
      <path d="M8 36h32" />
    </symbol>
    <symbol id="icon-stat-construction" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M8 40h32M12 40V22h24v18M18 22V12h12v10M24 12V6" />
      <path d="M18 30h12" />
    </symbol>
    <symbol id="icon-stat-ramp" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
