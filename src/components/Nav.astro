---
import { withBase } from '../lib/paths';
import Logo from './Logo.astro';
import { primaryNav, secondaryNav, site } from '../data/site';

interface Props {
  /** Dark variant for pages whose hero is black. */
  dark?: boolean;
}
const { dark = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class:list={['nav', { 'nav--dark': dark }]} data-nav>
  <div class="nav__bar">
    <a class="nav__logo" href={withBase('/')} aria-label={`${site.name} home`}>
      <Logo />
    </a>

    <nav class="nav__links desktop-only" aria-label="Primary">
      <ul class="nav__linksList textNav">
        {
          primaryNav.map((item) => (
            <li class="nav__link">
              <a class:list={['nav__item', { 'is-active': path.startsWith(withBase(item.href)) }]} href={withBase(item.href)}>
                {item.label}
                <svg aria-hidden="true" class="nav__arrow">
                  <use href="#icon-arrow-top-right" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="menuBtn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-btn>
      <span class="menuBtn__label menuBtn__label--open textNav">Menu</span>
      <span class="menuBtn__label menuBtn__label--close textNav">Close</span>
      <span class="menuBtn__ring" aria-hidden="true">
        <svg><use href="#icon-circle" /></svg>
      </span>
      <span class="menuBtn__close" aria-hidden="true">
        <svg><use href="#icon-close" /></svg>
      </span>
    </button>
  </div>
</header>

<div class="menuWrap" id="site-menu" data-menu hidden>
  <div class="menu__underlay" data-menu-underlay></div>
  <div class="menu">
    <div class="menu__inner">
      <a class="menu__logo" href={withBase('/')} aria-label={`${site.name} home`}>
        <Logo />
      </a>
      <div class="menu__main">
        <ul class="menu__list">
          {
            primaryNav.map((item, i) => (
              <li class="menuItem" style={`--i:${i}`}>
                <a class="menuItem__link" href={withBase(item.href)}>
                  <h2>{item.label}</h2>
                  <svg aria-hidden="true" class="menuItem__arrow">
                    <use href="#icon-arrow-top-right" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="menu__secondary">
          {
            secondaryNav.map((item, i) => (
              <li style={`--i:${i + primaryNav.length}`}>
                <a class="menu__secondaryLink" href={withBase(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="menu__footer">
        <p class="textSmall muted">{site.tagline}</p>
        <div class="menu__social">
          <a href={site.social.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
            <svg><use href="#icon-linkedin" /></svg>
          </a>
          <a href={site.social.x} target="_blank" rel="noreferrer" aria-label="X">
            <svg><use href="#icon-x" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.4rem var(--gutter) 0;
    pointer-events: none;
    --nav-bg: rgba(255, 255, 255, 0.72);
    --nav-fg: var(--color-ink);
    --nav-line: rgba(0, 0, 0, 0.08);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nav--dark,
  .nav.is-inverted {
    --nav-bg: rgba(18, 18, 20, 0.72);
    --nav-fg: var(--color-white);
    --nav-line: rgba(255, 255, 255, 0.12);
  }

  .nav.is-hidden {
    transform: translateY(-120%);
  }

  .nav__bar {
    pointer-events: auto;
    display: flex;
    align-items: stretch;
    height: var(--nav-h);
    color: var(--nav-fg);
    background: var(--nav-bg);
    border: 1px solid var(--nav-line);
    border-radius: 0.6rem;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    transition: background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    padding: 0 1.4rem;
    height: 100%;
    margin-right: auto;
  }

  .nav__logo :global(.logo) {
    height: 55%;
  }

  .nav__links {
    display: flex;
    align-items: stretch;
    border-left: 1px solid var(--nav-line);
  }

  .nav__linksList {
    display: flex;
    height: 100%;
  }

  .nav__link + .nav__link {
    border-left: 1px solid var(--nav-line);
  }

  .nav__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
    padding: 0 1.6rem;
    position: relative;
    transition: opacity 0.2s ease;
  }

  .nav__item:hover {
    opacity: 0.6;
  }

  .nav__item.is-active::after {
    content: '';
    position: absolute;
    left: 1.6rem;
    right: 1.6rem;
    bottom: 0.9rem;
    height: 1px;
    background: currentColor;
  }

  .nav__arrow {
    width: 0.8rem;
    height: 0.8rem;
  }

  .menuBtn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 0 1.6rem;
    border-left: 1px solid var(--nav-line);
    overflow: hidden;
  }

  .menuBtn__label {
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s ease;
  }

  .menuBtn__label--close {
    position: absolute;
    left: 1.6rem;
    transform: translateY(150%);
    opacity: 0;
  }

  .menuBtn[aria-expanded='true'] .menuBtn__label--open {
    transform: translateY(-150%);
    opacity: 0;
  }

  .menuBtn[aria-expanded='true'] .menuBtn__label--close {
    transform: none;
    opacity: 1;
  }

  .menuBtn__ring,
  .menuBtn__close {
    width: 1.1rem;
    height: 1.1rem;
    display: grid;
    place-items: center;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s ease;
  }

  .menuBtn__ring svg,
  .menuBtn__close svg {
    width: 100%;
    height: 100%;
  }

  .menuBtn__close {
    position: absolute;
    right: 1.6rem;
    transform: scale(0) rotate(-90deg);
    opacity: 0;
  }

  .menuBtn:hover .menuBtn__ring {
    transform: scale(1.25);
  }

  .menuBtn[aria-expanded='true'] .menuBtn__ring {
    transform: scale(0) rotate(90deg);
    opacity: 0;
  }

  .menuBtn[aria-expanded='true'] .menuBtn__close {
    transform: none;
    opacity: 1;
  }

  /* Full-screen menu */
  .menuWrap {
    position: fixed;
    inset: 0;
    z-index: 90;
  }

  .menuWrap[hidden] {
    display: none;
  }

  .menu__underlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .menu {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 100%;
    background: #0d0d0f;
    color: var(--color-white);
    transform: translateX(100%);
    transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1);
    overflow-y: auto;
  }

  @media (min-width: 900px) {
    .menu {
      width: 52rem;
      max-width: 60vw;
    }
  }

  .menuWrap.is-open .menu__underlay {
    opacity: 1;
  }

  .menuWrap.is-open .menu {
    transform: none;
  }

  .menu__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: calc(var(--nav-h) + 3.4rem) var(--gutter) 3rem;
  }

  .menu__logo {
    height: 2.4rem;
    display: block;
    width: max-content;
  }

  .menu__main {
    margin-top: 6rem;
    flex: 1;
  }

  .menuItem {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    opacity: 0;
    transform: translateY(1.6rem);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(0.25s + var(--i) * 0.06s);
  }

  .menuItem:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .menuWrap.is-open .menuItem {
    opacity: 1;
    transform: none;
  }

  .menuItem__link {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 2rem 0;
    font-size: 4.4rem;
    letter-spacing: -0.14rem;
    line-height: 0.95;
    transition:
      color 0.25s ease,
      transform 0.4s var(--ease-out);
  }

  @media (min-width: 900px) {
    .menuItem__link {
      font-size: 5.6rem;
      padding: 2.4rem 0;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .menuItem__link:hover {
      transform: translateX(1.2rem);
      color: var(--color-glow);
    }
  }

  .menuItem__arrow {
    width: 1.6rem;
    height: 1.6rem;
    margin-left: auto;
    margin-top: 0.8rem;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .menuItem__link:hover .menuItem__arrow {
    transform: translate(0.4rem, -0.4rem);
  }

  .menu__secondary {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem 2rem;
  }

  .menu__secondary li {
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(0.25s + var(--i) * 0.05s);
  }

  .menuWrap.is-open .menu__secondary li {
    opacity: 1;
    transform: none;
  }

  .menu__secondaryLink {
    font-size: 1.6rem;
    color: var(--color-grey-on-black);
    transition: color 0.2s ease;
  }

  .menu__secondaryLink:hover {
    color: var(--color-white);
  }

  .menu__footer {
    margin-top: 6rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .menu__social {
    display: flex;
    gap: 1.4rem;
  }

  .menu__social svg {
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-grey-on-black);
    transition: color 0.2s ease;
  }

  .menu__social a:hover svg {
    color: var(--color-white);
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const underlay = document.querySelector<HTMLElement>('[data-menu-underlay]');

  let open = false;

  function setOpen(next: boolean) {
    if (!btn || !menu) return;
    open = next;
    btn.setAttribute('aria-expanded', String(open));
    if (open) {
      menu.hidden = false;
      // Force a frame so the transition from translateX(100%) runs.
      requestAnimationFrame(() => menu.classList.add('is-open'));
      document.documentElement.style.overflow = 'hidden';
      nav?.classList.add('is-inverted');
    } else {
      menu.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      syncInversion();
      window.setTimeout(() => {
        if (!open) menu.hidden = true;
      }, 700);
    }
  }

  btn?.addEventListener('click', () => setOpen(!open));
  underlay?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) setOpen(false);
  });

  // Invert the nav while it overlaps a dark section, hide it while scrolling down.
  const darkSections = Array.from(document.querySelectorAll<HTMLElement>('[data-dark]'));
  const forcedDark = nav?.classList.contains('nav--dark') ?? false;

  function syncInversion() {
    if (!nav || open) return;
    const navBottom = nav.getBoundingClientRect().bottom;
    const overDark = darkSections.some((el) => {
      const r = el.getBoundingClientRect();
      return r.top <= navBottom && r.bottom >= navBottom;
    });
    nav.classList.toggle('is-inverted', forcedDark || overDark);
  }

  let lastY = window.scrollY;
  function onScroll() {
    const y = window.scrollY;
    if (nav && !open) {
      const goingDown = y > lastY && y > 120;
      nav.classList.toggle('is-hidden', goingDown && Math.abs(y - lastY) > 4);
    }
    lastY = y;
    syncInversion();
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', syncInversion);
  syncInversion();
</script>
