---
import { withBase } from '../lib/paths';
import SectionNumber from './SectionNumber.astro';

interface Props {
  n: number;
  label: string;
  title: string;
  body: string;
  href: string;
  cta?: string;
  art?: string;
  dark?: boolean;
}
const { n, label, title, body, href, cta = 'Explore', art = '', dark = true } = Astro.props;
---

<a class:list={['box', { 'box--dark onDark': dark }]} href={withBase(href)}>
  <div class:list={['box__art art', art]}></div>
  <div class="box__content">
    <div class="box__top">
      <SectionNumber n={n} label={label} />
    </div>
    <div class="box__bottom">
      <h3 class="textH2 box__title">{title}</h3>
      <p class="box__body">{body}</p>
      <span class="btnMain box__btn">
        {cta}
        <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-arrow-top-right" /></svg>
      </span>
    </div>
  </div>
</a>

<style>
  .box {
    position: relative;
    display: block;
    min-height: 52rem;
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .box--dark {
    background: #0b0d12;
    color: var(--color-white);
  }

  @media (min-width: 900px) {
    .box {
      min-height: 64rem;
    }
  }

  .box__art {
    position: absolute;
    inset: 0;
    border-radius: 0;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .box:hover .box__art {
    transform: scale(1.04);
  }

  .box__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    min-height: inherit;
    padding: 2.4rem;
  }

  @media (min-width: 900px) {
    .box__content {
      padding: 3.2rem;
    }
  }

  .box--dark .box__top :global(.sectionNumber) {
    color: var(--color-grey-on-black);
  }

  .box__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.6rem;
    margin-top: auto;
    padding-top: 20rem;
  }

  .box__body {
    max-width: 40rem;
    color: var(--color-grey-on-black);
  }

  .box:not(.box--dark) .box__body {
    color: var(--color-grey-on-white);
  }

  .box__btn {
    margin-top: 1.2rem;
    pointer-events: none;
  }

  .box:hover .box__btn {
    background: var(--color-white);
    color: var(--color-black);
  }

  .box:not(.box--dark):hover .box__btn {
    background: var(--color-ink);
    color: var(--color-white);
  }
</style>
