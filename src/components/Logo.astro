---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={`logo ${className}`} viewBox="0 0 150 32" role="img" aria-label="Qark Energy" fill="none">
  <!-- Mark: three points bound in a ring -->
  <circle cx="16" cy="16" r="13.5" fill="none" stroke="currentColor" stroke-width="1.4" />
  <circle cx="16" cy="8.5" r="2.4" fill="currentColor" />
  <circle cx="9.6" cy="19.8" r="2.4" fill="currentColor" />
  <circle cx="22.4" cy="19.8" r="2.4" fill="currentColor" />
  <path d="M16 8.5 9.6 19.8h12.8L16 8.5Z" fill="none" stroke="currentColor" stroke-width="1" opacity="0.55" />
  <!-- Wordmark -->
  <text
    x="40"
    y="23.5"
    fill="currentColor"
    font-family="Instrument Sans, Helvetica Neue, Arial, sans-serif"
    font-size="22"
    font-weight="500"
    letter-spacing="-0.6">Qark</text>
</svg>

<style>
  .logo {
    height: 100%;
    width: auto;
  }
</style>
