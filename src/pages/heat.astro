---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionNumber from '../components/SectionNumber.astro';

const uses = [
  {
    title: 'Chemicals and refining',
    body: 'Process steam at 320 ºC covers the majority of heat demand in ethylene crackers, ammonia synthesis and refinery distillation. Two Hadron modules can replace a 500 MWt gas-fired boiler house.',
  },
  {
    title: 'Data centers',
    body: 'Co-located Hadron modules deliver firm 24/7 power with no fuel logistics and no emissions, while waste heat drives absorption chillers that cut cooling loads by up to 40 percent.',
  },
  {
    title: 'District heating',
    body: 'A single module can heat a city of 150,000 people through a hot-water network, displacing natural gas and keeping a predictable, fuel-price-independent tariff.',
  },
  {
    title: 'Desalination',
    body: 'Pairing Hadron with multi-effect distillation produces 400,000 cubic meters of fresh water per day per module without burning fuel.',
  },
  {
    title: 'Hydrogen',
    body: 'High-temperature steam electrolysis fed by Hadron steam and electricity produces clean hydrogen at 25 percent lower energy cost than low-temperature electrolysis.',
  },
  {
    title: 'Pulp, paper and food',
    body: 'Drying, cooking and sterilization loads run on medium-pressure steam that Hadron supplies continuously, module by module, as plants expand.',
  },
];
---

<Layout
  title="Quark Heat"
  description="Quark Heat delivers carbon-free process steam and heat from Hadron modules to refineries, chemical plants, data centers and cities."
>
  <PageHero
    eyebrow="Quark Heat"
    title="Heat for<br />industry"
    intro="Electricity is only a fifth of the world's final energy use. Most of the rest is heat. Quark Heat delivers 320 ºC process steam from Hadron modules directly to the industries that need to decarbonize without downtime."
  />

  <section class="section pad-top-0">
    <div class="maxWidth">
      <div class="heat__hero art art--warm reveal">
        <div class="heat__heroLabel onDark">
          <p class="textSmall muted">Steam conditions at the fence line</p>
          <p class="textH1">320 ºC <span>/ 5.5 MPa</span></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={2} />
          <h2 class="textH3 reveal">The hardest third of emissions</h2>
        </div>
        <div class="prose reveal">
          <p>
            Industrial heat accounts for roughly a quarter of global energy consumption and a fifth of greenhouse gas
            emissions. Most of it is produced by burning gas or coal in boilers that run around the clock, and almost
            none of it can be practically electrified with intermittent power.
          </p>
          <p>
            Hadron modules were designed with this in mind. Steam leaves the module at 320 ºC, high enough to serve the
            majority of chemical, refining and manufacturing processes directly. Because each module is small, it can
            be sited inside an industrial fence line, and because the plant is passively safe, the nuclear island can
            be isolated from the host facility's operations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section onDark darkBlock" data-dark>
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={3} />
          <h2 class="textH3 reveal">Where Hadron heat goes to work</h2>
        </div>
        <div class="heat__usesWrap">
          <ul class="heat__uses">
            {
              uses.map((u, i) => (
                <li class="reveal" style={`--delay:${(i % 2) * 90}ms`}>
                  <p class="textSmall muted">{String(i + 1).padStart(2, '0')}</p>
                  <h3 class="textH4">{u.title}</h3>
                  <p class="muted">{u.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={4} />
          <h2 class="textH3 reveal">Heat as a service</h2>
        </div>
        <div class="prose reveal">
          <p>
            Quark Heat owns and operates the Hadron modules and sells steam and electricity under long-term contracts,
            so industrial customers never need to become nuclear operators. We handle licensing, fuel, operations and
            decommissioning; our customers receive a fixed-price, carbon-free energy supply for 20 years or more.
          </p>
          <p>
            Our first Quark Heat contract will supply two modules to a Gulf Coast chemical complex beginning in 2029,
            displacing about 1.2 million tonnes of CO₂ per year.
          </p>
          <div class="pageHero__actions">
            <a class="btnMain btnMain--solid" href={withBase('/contact')}>
              Talk to Quark Heat
              <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-arrow-top-right" /></svg>
            </a>
            <a class="btnMain" href={withBase('/hadron#fact-sheet')}>
              Hadron fact sheet
              <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-plus" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .heat__hero {
    aspect-ratio: 16 / 7;
    min-height: 32rem;
    display: flex;
    align-items: flex-end;
    padding: 3rem;
  }

  .heat__heroLabel {
    position: relative;
    z-index: 1;
    background: transparent;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .heat__heroLabel span {
    color: var(--color-grey-on-black);
  }

  .heat__usesWrap {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .heat__usesWrap {
      grid-column: 4 / span 9;
    }
  }

  .heat__uses {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 1.6rem;
  }

  @media (min-width: 700px) {
    .heat__uses {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .heat__uses li {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 2.4rem 0 3.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }
</style>
