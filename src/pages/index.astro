---
import Layout from '../layouts/Layout.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import SectionNumber from '../components/SectionNumber.astro';
import Stat from '../components/Stat.astro';
import CtaBox from '../components/CtaBox.astro';
import { site } from '../data/site';

const stats = [
  { icon: 'icon-stat-homes', label: 'Power to 70,000 homes per module', value: '80 MWe' },
  { icon: 'icon-stat-modules', label: 'Scalable plant configuration', value: '1 – 6 Modules', note: 'Up to 480 MWe on one site' },
  { icon: 'icon-stat-fuel', label: 'Factory-fabricated', value: '90% of components', note: 'Built off-site, shipped by rail' },
  { icon: 'icon-stat-safety', label: 'Passive safety', value: 'Zero operator action', note: 'Walk-away safe for an unlimited period' },
  { icon: 'icon-stat-heat', label: 'High-quality steam for industrial decarbonization', value: '320 ºC' },
  { icon: 'icon-stat-footprint', label: 'Overall site area', value: '~ 15 acres', note: 'For a six-module, 480 MWe plant' },
  { icon: 'icon-stat-construction', label: 'Rapid construction', value: '~ 24 Months', note: 'From first nuclear concrete to fuel load' },
  { icon: 'icon-stat-ramp', label: 'Load following', value: '20 – 100%', note: 'At 5% per minute, per module' },
  { icon: 'icon-stat-life', label: 'Design life', value: '60 Years', note: 'Refueling every 24 months' },
];
---

<Layout title={site.name} dark>
  <!-- 001 Hero -->
  <section class="hero onDark" data-dark>
    <HeroCanvas />
    <div class="hero__inner maxWidth">
      <div class="hero__top">
        <SectionNumber n={1} label="Clean energy future" class="hero__number" />
      </div>
      <div class="hero__bottom">
        <h1 class="textXL hero__title">
          <span class="hero__word" style="--d:0">Small</span>
          <span class="hero__word" style="--d:1">by</span>
          <span class="hero__word" style="--d:2">Design</span>
        </h1>
        <a class="hero__scroll textSmall" href="#intro">
          Scroll
          <svg aria-hidden="true"><use href="#icon-arrow-down" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 002 Intro -->
  <section class="section intro" id="intro">
    <div class="maxWidth">
      <div class="grid">
        <div class="intro__lead">
          <h2 class="textH2 reveal">
            Meeting surging global energy demand while preserving a livable planet will require nuclear power that
            is <span>small enough to build quickly and flexible enough to follow the grid.</span>
          </h2>
        </div>
        <div class="intro__side">
          <h3 class="textH3 reveal" style="--delay:120ms">
            The Hadron plant is a step forward for nuclear, delivering firm power in 80 MWe increments that can be
            added as demand grows.
          </h3>
          <p class="reveal" style="--delay:220ms">Our first Hadron plant is currently being built in {site.firstSite}.</p>
          <a class="btnMain reveal" style="--delay:300ms" href="/idaho">
            The {site.firstSite} project
            <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-plus" /></svg>
          </a>
        </div>
      </div>
      <div class="sectionFooter">
        <span class="textSmall muted">Hadron</span>
        <SectionNumber n={2} />
      </div>
    </div>
  </section>

  <!-- 003 Factory -->
  <section class="section feature">
    <div class="maxWidth">
      <div class="grid feature__grid">
        <div class="feature__media reveal">
          <div class="art feature__art">
            <svg class="feature__diagram" viewBox="0 0 400 520" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="1.2" aria-hidden="true">
              <rect x="120" y="40" width="160" height="440" rx="80" />
              <rect x="150" y="90" width="100" height="340" rx="50" stroke-dasharray="4 6" />
              <path d="M200 90v340" />
              <path d="M150 180h100M150 260h100M150 340h100" />
              <circle cx="200" cy="260" r="24" />
              <path d="M90 140h30M90 380h30M280 140h30M280 380h30" />
              <rect x="40" y="120" width="50" height="40" rx="6" /><rect x="40" y="360" width="50" height="40" rx="6" />
              <rect x="310" y="120" width="50" height="40" rx="6" /><rect x="310" y="360" width="50" height="40" rx="6" />
            </svg>
          </div>
        </div>
        <div class="feature__text">
          <SectionNumber n={3} class="feature__number" />
          <h3 class="textH3 reveal">
            The Hadron reactor is built in a factory, not a field.
          </h3>
          <p class="reveal" style="--delay:120ms">
            Each 80 MWe module is an integral pressurized-water reactor: core, steam generators and pressurizer live
            inside a single forged vessel that ships complete by rail. Standardized modules mean repeatable quality,
            predictable schedules and costs that fall with every unit we build.
          </p>
          <a class="linkArrow reveal" style="--delay:200ms" href="/hadron">
            How Hadron works
            <svg aria-hidden="true"><use href="#icon-arrow-top-right" /></svg>
          </a>
        </div>
      </div>
      <div class="sectionFooter">
        <span class="textSmall muted">Integral module</span>
        <SectionNumber n={4} />
      </div>
    </div>
  </section>

  <!-- 005 Flexibility -->
  <section class="section feature feature--flip">
    <div class="maxWidth">
      <div class="grid feature__grid">
        <div class="feature__text">
          <SectionNumber n={5} class="feature__number" />
          <h3 class="textH3 reveal">
            While renewable energy is carbon-free, it is sometimes unavailable due to weather conditions.
          </h3>
          <p class="reveal" style="--delay:120ms">
            Hadron modules ramp between 20 and 100 percent output at 5 percent per minute, filling the gap when wind
            and solar fall off and stepping back when they return. A six-module plant behaves like a gigawatt-scale
            battery that never runs down.
          </p>
          <a class="linkArrow reveal" style="--delay:200ms" href="/hadron#grid">
            Hadron on the grid
            <svg aria-hidden="true"><use href="#icon-arrow-top-right" /></svg>
          </a>
        </div>
        <div class="feature__media reveal">
          <div class="art art--mint feature__art">
            <svg class="feature__diagram feature__diagram--chart" viewBox="0 0 600 320" fill="none" aria-hidden="true">
              <path d="M0 240 C80 230 120 90 200 110 S320 260 400 230 540 100 600 120" stroke="rgba(255,255,255,0.35)" stroke-width="1.2" stroke-dasharray="3 6" />
              <path d="M0 200 C80 210 120 290 200 270 S320 150 400 180 540 290 600 270" stroke="#fff" stroke-width="1.6" />
              <path d="M0 300h600" stroke="rgba(255,255,255,0.25)" />
              <text x="12" y="188" fill="rgba(255,255,255,0.8)" font-size="12" font-family="Instrument Sans, sans-serif">Hadron output</text>
              <text x="12" y="252" fill="rgba(255,255,255,0.5)" font-size="12" font-family="Instrument Sans, sans-serif">Wind + solar</text>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Clear Advantage -->
  <section class="section advantage">
    <div class="maxWidth">
      <div class="grid">
        <div class="advantage__head">
          <h2 class="textH1 reveal">Clear Advantage</h2>
        </div>
        <div class="advantage__intro">
          <p class="textH4 reveal" style="--delay:120ms">
            By moving to a small, standardized plant design, the Hadron technology requires far fewer resources to
            construct and operate. This results in lower costs, shorter schedules and higher value for the communities
            that host it.
          </p>
        </div>
      </div>
      <ul class="advantage__stats">
        {stats.map((s, i) => <Stat {...s} index={i} />)}
      </ul>
      <div class="advantage__cta">
        <a class="btnMain" href="/hadron#fact-sheet">
          Hadron fact sheet
          <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-plus" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 006 / 007 CTAs -->
  <section class="section ctas">
    <div class="maxWidth">
      <div class="ctas__grid">
        <CtaBox
          n={6}
          label="Hadron"
          title="The Hadron plant"
          body="An 80 MWe integral reactor, factory-built and passively safe. Learn how the Hadron module redefines what a nuclear plant can be."
          href="/hadron"
          cta="Explore Hadron"
        />
        <CtaBox
          n={7}
          label="Quark Heat"
          title="Heat for industry"
          body="Hadron modules supply 320 ºC process steam to refineries, chemical plants and data centers that need to decarbonize without downtime."
          href="/heat"
          cta="Explore Quark Heat"
          art="art--warm"
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100svh;
    padding: calc(var(--nav-h) + 4rem) 0 3rem;
  }

  .hero__number {
    color: var(--color-grey-on-black);
  }

  .hero__bottom {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .hero__bottom {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .hero__title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25em;
    max-width: 90rem;
  }

  .hero__word {
    display: inline-block;
    opacity: 0;
    transform: translateY(40%);
    animation: wordIn 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: calc(0.3s + var(--d) * 0.12s);
  }

  .hero__word:nth-child(2) {
    color: var(--color-grey-on-black);
  }

  @keyframes wordIn {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-grey-on-black);
    white-space: nowrap;
  }

  .hero__scroll svg {
    width: 1rem;
    height: 1rem;
    animation: bob 2.2s ease-in-out infinite;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(0.4rem);
    }
  }

  /* Section footer rule */
  .sectionFooter {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--color-line);
  }

  /* Intro */
  .intro__lead {
    grid-column: 1 / -1;
  }

  .intro__side {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.4rem;
    margin-top: 4rem;
  }

  @media (min-width: 900px) {
    .intro__lead {
      grid-column: 1 / span 8;
    }
    .intro__side {
      grid-column: 1 / span 6;
      margin-top: 8rem;
    }
  }

  /* Feature */
  .feature__grid {
    row-gap: 4rem;
  }

  .feature__media {
    grid-column: 1 / -1;
  }

  .feature__art {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
  }

  .feature__diagram {
    position: relative;
    z-index: 1;
    width: 60%;
    height: auto;
    fill: none;
  }

  .feature__diagram--chart {
    width: 90%;
  }

  .feature__text {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.4rem;
  }

  .feature__number {
    margin-bottom: 1rem;
  }

  @media (min-width: 900px) {
    .feature__media {
      grid-column: 1 / span 6;
    }
    .feature__text {
      grid-column: 8 / span 5;
      justify-content: center;
    }
    .feature--flip .feature__text {
      grid-column: 1 / span 5;
      grid-row: 1;
    }
    .feature--flip .feature__media {
      grid-column: 7 / span 6;
      grid-row: 1;
    }
    .feature--flip .feature__art {
      aspect-ratio: 5 / 4;
    }
  }

  /* Advantage */
  .advantage {
    padding-top: 4rem;
  }

  .advantage__head {
    grid-column: 1 / -1;
  }

  .advantage__intro {
    grid-column: 1 / -1;
    margin-top: 3rem;
  }

  @media (min-width: 900px) {
    .advantage__head {
      grid-column: 1 / span 6;
    }
    .advantage__intro {
      grid-column: 8 / span 5;
      margin-top: 0;
      align-self: end;
    }
  }

  .advantage__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 1.6rem;
    margin-top: 6rem;
  }

  @media (min-width: 600px) {
    .advantage__stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .advantage__stats {
      grid-template-columns: repeat(3, 1fr);
      margin-top: 8rem;
    }
  }

  .advantage__cta {
    margin-top: 2rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-line);
  }

  /* CTAs */
  .ctas {
    padding-top: 0;
    padding-bottom: 2rem;
  }

  .ctas__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  @media (min-width: 900px) {
    .ctas__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
