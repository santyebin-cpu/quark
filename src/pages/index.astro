---
import { Picture } from 'astro:assets';
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
import { photos } from '../data/media';
import { principalData, threeStages as stages } from '../data/qark-one';
import plantCutaway from '../assets/plant/plant-cutaway.jpg';
import factoryHall from '../assets/plant/factory-hall.jpg';
import poolHall from '../assets/plant/pool-hall.jpg';
import reactorVessel from '../assets/plant/reactor-vessel.jpg';
import blueprint from '../assets/plant/blueprint.webp';

const widths = [640, 960, 1280, 1600, 2000];
const formats = ['avif', 'webp'] as const;

// Split into words at build time so scroll can light them one by one.
const leadWords =
  'India aims for 100 GW of nuclear power by 2047, about ten times what it runs today. Getting there takes'.split(' ');
const highlightWords = 'reactors India can build quickly, run safely and fuel with its own thorium.'.split(' ');

const tourCaptions = [
  {
    title: 'The whole plant',
    text: 'About 300 MWe of firm, carbon-free power from one reactor, on a compact site.',
  },
  {
    title: 'Turbine hall',
    text: 'Steam from the reactor drives a turbine-generator, the same kind of machine that runs in any thermal power station.',
  },
  {
    title: 'Reactor building',
    text: 'The reactor sits beneath a pool of about 8,000 m³ of water, held high in the building to cool the core by gravity alone.',
  },
  {
    title: 'Control building',
    text: 'Operators run the plant from a control room in its own building, beside the electrical and instrumentation systems.',
  },
];

const tourLabels = [
  { label: 'Turbine hall', x: 23, y: 17 },
  { label: 'Reactor building', x: 55, y: 13 },
  { label: 'Control building', x: 82, y: 23 },
];

const safetyData = [
  ['Grace period', '72 hours without power or operator action'],
  ['Water pool', 'About 8,000 m³, fed by gravity'],
  ['Circulation', 'Natural, with no primary pumps'],
  ['Shutdown', 'Two independent systems'],
];

const fuelData = [
  ['Fuel', '(Th–HALEU)O₂, 54-pin clusters'],
  ['Fuel channels', '452, vertical'],
  ['Refuelling', 'On power, from the top'],
];

const doors = [
  {
    who: 'Utilities & industry',
    title: 'Buy power or steam',
    text: 'Firm electricity, plus steam for industry and desalination.',
    href: '/industry',
  },
  {
    who: 'Government & partners',
    title: 'Partner with us',
    text: 'Engineering, manufacturing and research partners across India.',
    href: '/contact?topic=partners',
  },
  {
    who: 'Investors',
    title: 'Invest in Qark One',
    text: 'Talk to us about funding the next stage of the design.',
    href: '/contact?topic=investors',
  },
  {
    who: 'Engineers',
    title: 'Join the team',
    text: 'Reactor physics, thermal-hydraulics, mechanical design and licensing.',
    href: '/careers',
  },
];
---

<Layout
  title={site.name}
  description="Qark Energy is developing Qark One, a thorium-fuelled small modular reactor for India with passive safety and about 300 MWe of firm, carbon-free power."
  dark
>
  <!-- Fixed chapter indicator (bottom corners), updated as chapters scroll past -->
  <div class="chapter" aria-hidden="true">
    <span class="textSmall" data-chapter-label>{site.productLong}</span>
    <span class="textSmall" data-chapter-num>001</span>
  </div>

  <!-- 001–002 Opener: the WebGL core lattice stays pinned behind the hero and the statement -->
  <div class="opener onDark" data-dark data-hero-scope>
    <div class="opener__stage">
      <div class="opener__pin">
        <HeroCanvas />
      </div>
    </div>

    <section class="hero" data-chapter={site.productLong} data-n="1">
      <div class="hero__inner maxWidth">
        <h1 class="textXL hero__title lines lines--inline" style="--delay:450ms">
          <span class="line"><span>More power</span></span>
          <span class="line"><span>for India</span></span>
        </h1>
      </div>
    </section>

    <section class="statement" data-chapter="India 2047" data-n="2" data-statement>
      <div class="statement__sticky">
        <div class="maxWidth">
          <p class="statement__text">
            {leadWords.map((w) => <span class="w">{w} </span>)}
            {highlightWords.map((w) => <span class="w w--hl">{w} </span>)}
          </p>
          <a class="learnMore learnMore--light statement__more" href={withBase('/thorium')}>
            <span>Learn more<br />about thorium</span>
            <i class="learnMore__dot"></i>
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- 003 The plant: pinned tour through the cutaway -->
  <section class="tour" data-chapter="The plant" data-n="3">
    <div class="maxWidth grid chapterHead">
      <h2 class="textH1 twoTone lines chapterHead__title">
        <span class="line"><span>One Plant</span></span>
        <span class="line"><span>Three Buildings</span></span>
      </h2>
      <p class="textH4 chapterHead__intro reveal" style="--delay:120ms">
        Qark One is a single reactor of about 300 MWe. Scroll through the plant: turbine hall, reactor building and
        control building, each with one job.
      </p>
    </div>

    <div class="tour__track" data-tour>
      <div class="tour__sticky">
        <div class="tour__frame">
          <div class="tour__camera">
            <Picture
              src={plantCutaway}
              widths={widths}
              formats={formats}
              sizes="(min-width: 900px) 80vw, 100vw"
              alt="Concept render of a Qark One plant in cutaway: turbine hall on the left, reactor building in the centre, control building on the right"
              class="tour__img tour__base"
              loading="lazy"
            />
            <div class="tour__lit" aria-hidden="true">
              <Picture
                src={plantCutaway}
                widths={widths}
                formats={formats}
                sizes="(min-width: 900px) 80vw, 100vw"
                alt=""
                class="tour__img"
                loading="lazy"
              />
            </div>
            {
              tourLabels.map((l) => (
                <span class="tour__label" style={`left:${l.x}%;top:${l.y}%`}>
                  <i aria-hidden="true" />
                  {l.label}
                </span>
              ))
            }
          </div>
          <span class="renderTag">Concept render</span>
        </div>

        <div class="tour__captions">
          {
            tourCaptions.map((c, i) => (
              <div class:list={['tour__caption', { 'is-active': i === 0 }]}>
                <p class="tour__step textSmall tabular">{i === 0 ? 'Overview' : `${i} / 3`}</p>
                <h3 class="tour__title">{c.title}</h3>
                <p class="tour__text">{c.text}</p>
              </div>
            ))
          }
          <div class="tour__dots" aria-hidden="true">
            {[1, 2, 3].map(() => <i class="tour__dot" />)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 004 Made in India: the factory render pans while pinned -->
  <section class="pan" data-chapter="Made in India" data-n="4">
    <div class="pan__track" data-pan>
      <div class="pan__sticky">
        <div class="pan__frame">
          <div class="pan__strip">
            <Picture
              src={factoryHall}
              widths={widths}
              formats={formats}
              sizes="(min-width: 900px) 150vw, 300vw"
              alt="Concept render of a factory hall where large reactor components are fabricated"
              class="pan__img"
              loading="lazy"
            />
          </div>
          <span class="renderTag">Concept render</span>
          <div class="pan__card">
            <h2 class="textH1 twoTone lines">
              <span class="line"><span>Made in</span></span>
              <span class="line"><span>India</span></span>
            </h2>
            <p class="pan__text reveal" style="--delay:120ms">
              Qark One is designed around components that Indian industry can fabricate in its own workshops and
              deliver to site for assembly. India’s heavy-engineering firms have been making reactor components for
              decades.
            </p>
            <a class="learnMore reveal" style="--delay:200ms" href={withBase('/india')}>
              <span>Learn more<br />about building in India</span>
              <i class="learnMore__dot"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 005 Safe by gravity: the pool hall opens to full-bleed -->
  <section class="expand" data-chapter="Safe by gravity" data-n="5">
    <div class="expand__track" data-expand>
      <div class="expand__sticky">
        <div class="expand__frame">
          <Picture
            src={poolHall}
            widths={widths}
            formats={formats}
            sizes="100vw"
            alt="Concept render of an underground reactor building with deep pools of water"
            class="expand__img"
            loading="lazy"
          />
          <div class="expand__shade"></div>
          <span class="renderTag renderTag--dark">Concept render</span>
          <div class="expand__overlay maxWidth">
            <h2 class="textH1 expand__title">
              <span class="line"><span>Safe by</span></span>
              <span class="line"><span>Gravity</span></span>
            </h2>
            <div class="expand__copy">
              <p class="textH4">
                If the plant loses all power, Qark One needs no pumps, no diesel and no operators to stay safe. Water
                flows down from the pool by gravity, natural circulation carries the heat away, and the core stays
                cool for 72 hours with no action at all.
              </p>
              <dl class="facts facts--light">
                {
                  safetyData.map(([k, v]) => (
                    <div class="facts__row">
                      <dt>{k}</dt>
                      <dd>{v}</dd>
                    </div>
                  ))
                }
              </dl>
              <a class="learnMore learnMore--light" href={withBase('/qark-one#safety')}>
                <span>Learn more<br />about passive safety</span>
                <i class="learnMore__dot"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 006 The reactor: the vessel render, its core glowing -->
  <section class="vessel" data-chapter="The reactor" data-n="6">
    <div class="maxWidth grid vessel__grid">
      <div class="vessel__text">
        <h2 class="textH1 twoTone lines">
          <span class="line"><span>Refuelled</span></span>
          <span class="line"><span>While Running</span></span>
        </h2>
        <p class="textH4 reveal" style="--delay:120ms">
          Qark One burns thorium oxide mixed with high-assay low-enriched uranium (HALEU), packed into 54-pin
          clusters. Fresh fuel goes in from the top while the reactor keeps running, so the plant never has to shut
          down just to refuel.
        </p>
        <dl class="facts reveal" style="--delay:200ms">
          {
            fuelData.map(([k, v]) => (
              <div class="facts__row">
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
        <a class="learnMore reveal" style="--delay:260ms" href={withBase('/qark-one')}>
          <span>Learn more<br />about Qark One</span>
          <i class="learnMore__dot"></i>
        </a>
      </div>
      <figure class="photo photo--reveal vessel__plate" data-reveal-media data-parallax>
        <div class="photo__inner">
          <Picture
            src={reactorVessel}
            widths={widths}
            formats={formats}
            sizes="(min-width: 900px) 55vw, 100vw"
            alt="Concept render of a reactor vessel in cutaway with the core glowing at its base"
            loading="lazy"
          />
          <span class="vessel__glowWrap" aria-hidden="true"><span class="vessel__glow"></span></span>
        </div>
        <figcaption class="renderTag">Concept render</figcaption>
      </figure>
    </div>
  </section>

  <!-- 007 The design: the drawing draws itself in, then the principal data -->
  <section class="design onDark" data-dark data-chapter="The design" data-n="7">
    <div class="maxWidth">
      <div class="grid chapterHead chapterHead--compact">
        <h2 class="textH1 lines chapterHead__title design__title">
          <span class="line"><span>Drawn in</span></span>
          <span class="line"><span>Detail</span></span>
        </h2>
        <p class="textH4 chapterHead__intro reveal" style="--delay:120ms">
          The general arrangement for Qark One, drawn from published data for the AHWR-300 LEU, the thorium reactor
          designed by India’s Bhabha Atomic Research Centre.
        </p>
      </div>

      <figure class="design__sheet" data-blueprint>
        <Picture
          src={blueprint}
          widths={widths}
          formats={formats}
          sizes="(min-width: 900px) 92vw, 100vw"
          alt="General arrangement drawing QE-GA-001 for Qark One: reactor block section, core lattice plan, coolant channel detail, parts list and principal data"
          class="design__img"
          loading="lazy"
        />
        <span class="design__scan" aria-hidden="true"></span>
      </figure>

      <div class="grid design__data">
        <div class="design__dataHead">
          <h3 class="textH3">Principal data</h3>
          <p class="design__note">
            Concept status. Indicative arrangement from published AHWR-300 LEU data; dimensions approximate, not for
            construction.
          </p>
          <a class="learnMore learnMore--light" href={blueprint.src} target="_blank" rel="noopener">
            <span>View the<br />full drawing</span>
            <i class="learnMore__dot"></i>
          </a>
        </div>
        <dl class="facts facts--light facts--wide tabular">
          {
            principalData.map(([k, v]) => (
              <div class="facts__row">
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- 008 Thorium: India's three-stage programme -->
  <section class="thorium" data-chapter="Thorium" data-n="8">
    <div class="maxWidth">
      <div class="grid chapterHead chapterHead--compact">
        <h2 class="textH1 twoTone lines chapterHead__title">
          <span class="line"><span>India’s Own</span></span>
          <span class="line"><span>Fuel</span></span>
        </h2>
        <p class="textH4 chapterHead__intro reveal" style="--delay:120ms">
          India holds one of the world’s largest reserves of thorium, much of it in the monazite sands along its coast.
          Since the 1950s, its three-stage nuclear programme has aimed to make thorium its main fuel.
        </p>
      </div>

      <div class="grid thorium__body">
        <Photo photo={photos.coast} class="thorium__photo" sizes="(min-width: 900px) 40vw, 100vw" />
        <div class="thorium__stages">
          <ol class="stages" data-stages>
            {
              stages.map((s, i) => (
                <li class="stages__item" style={`--i:${i}`}>
                  <p class="stages__label textSmall">{s.stage}</p>
                  <h3 class="stages__title">{s.title}</h3>
                  <p class="stages__text">{s.text}</p>
                </li>
              ))
            }
          </ol>
          <p class="thorium__qark reveal">
            <strong>Qark One</strong> is designed to put thorium to work now, with HALEU as its driver fuel, rather
            than waiting for stage three.
          </p>
          <a class="learnMore reveal" href={withBase('/thorium')}>
            <span>Learn more<br />about thorium</span>
            <i class="learnMore__dot"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 009 Work with us: one door per audience -->
  <section class="doors" data-chapter="Work with us" data-n="9">
    <div class="maxWidth">
      <h2 class="textH1 twoTone lines">
        <span class="line"><span>Work With</span></span>
        <span class="line"><span>Qark Energy</span></span>
      </h2>
      <ul class="doors__list">
        {
          doors.map((d, i) => (
            <li class="doors__item reveal" style={`--delay:${i * 70}ms`}>
              <a class="door" href={withBase(d.href)}>
                <span class="door__who textSmall">{d.who}</span>
                <span class="door__title">{d.title}</span>
                <span class="door__text">{d.text}</span>
                <span class="door__arrow" aria-hidden="true">
                  <svg>
                    <use href="#icon-arrow-top-right" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<script>
  const clamp = (v: number, min = 0, max = 1) => Math.min(max, Math.max(min, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const reduced = document.documentElement.classList.contains('motion-reduced');

  const $ = (sel: string, root: ParentNode = document) => root.querySelector<HTMLElement>(sel);
  const $$ = (sel: string, root: ParentNode = document) => Array.from(root.querySelectorAll<HTMLElement>(sel));

  // 0 → 1 while a tall pinned track scrolls past.
  function progressOf(rect: DOMRect, vh: number) {
    return clamp(-rect.top / Math.max(1, rect.height - vh));
  }

  /* Statement */
  const statement = $('[data-statement]');
  const words = statement ? $$('.w', statement) : [];
  const statementMore = statement ? $('.statement__more', statement) : null;

  /* Plant tour: camera (centre and zoom over the image) and the lit window for each stop */
  const tour = $('[data-tour]');
  const tourCamera = tour ? $('.tour__camera', tour) : null;
  const tourLit = tour ? $('.tour__lit', tour) : null;
  const tourLabels = tour ? $$('.tour__label', tour) : [];
  const tourCaptions = tour ? $$('.tour__caption', tour) : [];
  const tourDots = tour ? $$('.tour__dot', tour) : [];
  type Stop = { cx: number; cy: number; z: number; inset: [number, number, number, number] };
  const stops: Stop[] = [
    { cx: 0.5, cy: 0.5, z: 1, inset: [0, 0, 0, 0] },
    { cx: 0.23, cy: 0.44, z: 1.35, inset: [0.08, 0.595, 0.215, 0.055] },
    { cx: 0.55, cy: 0.5, z: 1.2, inset: [0, 0.295, 0, 0.395] },
    { cx: 0.82, cy: 0.47, z: 1.4, inset: [0.155, 0.045, 0.215, 0.695] },
  ];
  // [start, end, from stop, to stop] as fractions of the pinned track; holds sit between moves.
  const moves: [number, number, number, number][] = [
    [0.1, 0.25, 0, 1],
    [0.37, 0.52, 1, 2],
    [0.64, 0.79, 2, 3],
    [0.88, 1, 3, 0],
  ];
  function tourAt(p: number) {
    for (const [s, e, from, to] of moves) {
      if (p < s) return { from, to: from, t: 0 };
      if (p <= e) return { from, to, t: easeInOut((p - s) / (e - s)) };
    }
    return { from: 0, to: 0, t: 0 };
  }

  /* Made in India pan */
  const pan = $('[data-pan]');
  const panFrame = pan ? $('.pan__frame', pan) : null;
  const panStrip = pan ? $('.pan__strip', pan) : null;
  let panDistance = 0;
  function measurePan() {
    if (panFrame && panStrip) panDistance = Math.max(0, panStrip.offsetWidth - panFrame.clientWidth);
  }

  /* Safe by gravity: the photo opens to full-bleed, then the copy arrives */
  const expand = $('[data-expand]');
  const expandFrame = expand ? $('.expand__frame', expand) : null;
  const expandImg = expand ? $('.expand__img', expand) : null;
  const expandShade = expand ? $('.expand__shade', expand) : null;
  const expandLines = expand ? $$('.expand__title .line > span', expand) : [];
  const expandCopy = expand ? $('.expand__copy', expand) : null;

  /* Chapter indicator */
  const chapterSections = $$('[data-chapter]');
  const labelEl = $('[data-chapter-label]');
  const numEl = $('[data-chapter-num]');
  const chapterEl = $('.chapter');
  const footer = $('footer');

  let ticking = false;

  function update() {
    ticking = false;
    const vh = window.innerHeight;

    // Read phase: every rect first, so the writes below never force a layout in between.
    const statementRect = statement?.getBoundingClientRect();
    const tourRect = tour?.getBoundingClientRect();
    const panRect = pan?.getBoundingClientRect();
    const expandRect = expand?.getBoundingClientRect();
    const chapterTops = chapterSections.map((s) => s.getBoundingClientRect().top);
    const footerTop = footer ? footer.getBoundingClientRect().top : Infinity;

    // Statement: an opacity change only, so it runs in reduced-motion mode too.
    if (statementRect) {
      const p = progressOf(statementRect, vh);
      const lit = clamp(p / 0.75) * (words.length + 1);
      words.forEach((w, i) => (w.style.opacity = String(0.14 + 0.86 * clamp(lit - i))));
      if (statementMore) statementMore.style.opacity = String(clamp((p - 0.72) * 6));
    }

    if (tourRect && tourCamera && tourLit) {
      const { from, to, t } = tourAt(progressOf(tourRect, vh));
      const a = stops[from];
      const b = stops[to];
      const active = t < 0.5 ? from : to;
      if (!reduced) {
        const z = lerp(a.z, b.z, t);
        // Keep the view inside the image at every zoom.
        const cx = clamp(lerp(a.cx, b.cx, t), 0.5 / z, 1 - 0.5 / z);
        const cy = clamp(lerp(a.cy, b.cy, t), 0.5 / z, 1 - 0.5 / z);
        tourCamera.style.transform = `translate3d(${(0.5 - cx) * 100 * z}%, ${(0.5 - cy) * 100 * z}%, 0) scale(${z})`;
        const inset = a.inset.map((v, i) => lerp(v, b.inset[i], t) * 100);
        tourLit.style.clipPath = `inset(${inset[0]}% ${inset[1]}% ${inset[2]}% ${inset[3]}% round 0.6rem)`;
        tourLabels.forEach((l) => (l.style.transform = `translate(-50%, -100%) scale(${1 / z})`));
      }
      tourLabels.forEach((l, i) => l.classList.toggle('is-active', active === i + 1));
      tourCaptions.forEach((c, i) => c.classList.toggle('is-active', active === i));
      tourDots.forEach((d, i) => d.classList.toggle('is-active', active === i + 1));
    }

    if (panRect && panStrip && !reduced) {
      const p = clamp((progressOf(panRect, vh) - 0.04) / 0.92);
      panStrip.style.transform = `translate3d(${-panDistance * p}px, 0, 0)`;
    }

    if (expandRect && expandFrame) {
      const p = reduced ? 1 : progressOf(expandRect, vh);
      const e = easeInOut(clamp(p / 0.6));
      const t = easeOut(clamp((p - 0.6) / 0.25));
      if (!reduced) {
        expandFrame.style.clipPath = `inset(${(1 - e) * 17}svh ${(1 - e) * 24}vw round ${(1 - e) * 2}rem)`;
        if (expandImg) expandImg.style.transform = `scale(${1.32 - e * 0.32})`;
        expandLines.forEach((l) => (l.style.transform = `translate3d(0, ${(1 - t) * 110}%, 0)`));
        if (expandCopy) expandCopy.style.transform = `translate3d(0, ${(1 - t) * 3}rem, 0)`;
      }
      if (expandShade) expandShade.style.opacity = String(0.25 + t * 0.75);
      if (expandCopy) expandCopy.style.opacity = String(t);
    }

    // Active chapter = last section whose top has passed the middle of the viewport.
    let active = 0;
    chapterTops.forEach((top, i) => {
      if (top <= vh * 0.5) active = i;
    });
    const section = chapterSections[active];
    if (section && labelEl && numEl) {
      labelEl.textContent = section.dataset.chapter || '';
      numEl.textContent = String(section.dataset.n || 1).padStart(3, '0');
    }
    chapterEl?.classList.toggle('is-hidden', footerTop < vh);
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  // One-shot reveals that should wait until a good share of the element is on screen.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.35 },
  );
  $$('[data-blueprint], [data-stages]').forEach((el) => io.observe(el));

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => {
    measurePan();
    onScroll();
  });
  window.addEventListener('load', () => {
    measurePan();
    onScroll();
  });
