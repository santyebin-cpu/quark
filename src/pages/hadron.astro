---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionNumber from '../components/SectionNumber.astro';

const specs = [
  ['Reactor type', 'Integral pressurized-water reactor (iPWR)'],
  ['Electrical output', '80 MWe per module (net)'],
  ['Thermal output', '250 MWt per module'],
  ['Plant configuration', '1 to 6 modules, 80 – 480 MWe'],
  ['Fuel', 'UO₂, enriched < 5% U-235, 17×17 assemblies'],
  ['Refueling interval', '24 months, staggered by module'],
  ['Primary circulation', 'Natural circulation, no reactor coolant pumps'],
  ['Primary operating pressure', '12.8 MPa'],
  ['Steam conditions', '320 ºC, 5.5 MPa'],
  ['Vessel dimensions', '3.7 m diameter × 22 m height, rail-shippable'],
  ['Emergency core cooling', 'Passive, indefinite coping time, no AC power or operator action'],
  ['Seismic design', 'Below-grade pool, seismic isolation of module bay'],
  ['Overall site area', '~ 15 acres for a six-module plant'],
  ['Construction duration', '~ 24 months from first nuclear concrete to fuel load'],
  ['Design life', '60 years'],
];
---

<Layout
  title="Hadron"
  description="The Hadron small modular reactor: an 80 MWe, factory-built, passively safe integral reactor that scales from one to six modules."
>
  <PageHero
    eyebrow="Hadron"
    title="The Plant"
    intro="The Hadron® reactor redefines what nuclear technology can be: emissions-free, competitive and flexible. Built in a factory for the 21st-century grid, Hadron is one of the fastest and lowest-cost paths to advanced, zero-carbon energy."
  >
    <div class="pageHero__actions">
      <a class="btnMain" href="#fact-sheet">
        Fact sheet
        <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-arrow-down" /></svg>
      </a>
    </div>
  </PageHero>

  <section class="section pad-top-0">
    <div class="maxWidth">
      <div class="art art--light hadron__hero reveal">
        <svg class="hadron__cutaway" viewBox="0 0 1200 520" fill="none" stroke="rgba(42,42,46,0.75)" stroke-width="1.2" aria-hidden="true">
          <!-- pool -->
          <path d="M80 120h1040v360H80z" stroke-dasharray="4 8" />
          <path d="M80 480h1040" stroke-width="2" />
          <!-- six modules -->
          {
            Array.from({ length: 6 }, (_, i) => (
              <g transform={`translate(${160 + i * 160} 0)`}>
                <rect x="0" y="150" width="90" height="300" rx="45" fill={i < 4 ? 'rgba(79,125,249,0.12)' : 'none'} />
                <rect x="20" y="190" width="50" height="220" rx="25" stroke-dasharray="3 5" />
                <path d="M45 190v220" />
                <circle cx="45" cy="300" r="14" />
                <text x="45" y="135" text-anchor="middle" fill="rgba(42,42,46,0.7)" font-size="12" font-family="Instrument Sans, sans-serif" stroke="none">
                  {`M${i + 1}`}
                </text>
              </g>
            ))
          }
          <!-- turbine island -->
          <rect x="80" y="40" width="1040" height="50" rx="8" />
          <text x="100" y="70" fill="rgba(42,42,46,0.7)" font-size="12" font-family="Instrument Sans, sans-serif" stroke="none">Turbine island — 6 × 80 MWe</text>
          <text x="100" y="505" fill="rgba(42,42,46,0.7)" font-size="12" font-family="Instrument Sans, sans-serif" stroke="none">Below-grade module pool</text>
        </svg>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={2} />
          <h2 class="textH3 reveal">Quark's Hadron project and the ARDP partnership</h2>
        </div>
        <div class="prose reveal">
          <p>
            Quark is building its first plant through a public-private partnership with the U.S. Department of Energy's
            Advanced Reactor Demonstration Program (ARDP).
          </p>
          <p>
            The program authorizes a 50/50 cost share of up to $1.6 billion for the Hadron demonstration project, which
            Quark and its partners will match dollar for dollar. The first-of-a-kind scope includes reactor design and
            licensing, codes and methods development, the Columbus module factory, and the design, construction and
            operation of two supporting facilities: the Hadron Integral Effects Test Loop in Boise and the Module
            Assembly and Fit-Up Facility adjacent to the Idaho site. The test loop is used to demonstrate the performance
            of first-of-a-kind equipment before it operates in the reactor plant.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section onDark darkBlock" data-dark>
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={3} />
          <h2 class="textH3 reveal">The Hadron reactor's groundbreaking technology</h2>
        </div>
        <div class="prose reveal">
          <p>
            Unlike today's gigawatt-scale light-water reactors, the Hadron module is an 80 MWe integral pressurized-water
            reactor whose core, steam generators and pressurizer share a single forged vessel. There are no large-bore
            primary pipes to break and no reactor coolant pumps to fail: water circulates by natural convection alone.
          </p>
          <p>
            Modules are manufactured on a production line and shipped complete by rail, then lowered into a below-grade,
            water-filled pool. Up to six modules share one turbine island, providing built-in redundancy and letting a
            plant grow in 80 MWe steps as demand develops. This makes Hadron a perfect fit for high-renewable grids,
            retiring coal sites and industrial campuses where variable output and long construction schedules are a
            concern.
          </p>
        </div>
      </div>

      <ul class="pillars">
        <li class="reveal">
          <p class="textSmall muted">Integral</p>
          <p class="textH4">One vessel contains the entire primary system. Fewer welds, fewer penetrations, fewer things that can go wrong.</p>
        </li>
        <li class="reveal" style="--delay:100ms">
          <p class="textSmall muted">Modular</p>
          <p class="textH4">Standard 80 MWe units built to a single licensed design, in a factory with a learning curve measured in weeks.</p>
        </li>
        <li class="reveal" style="--delay:200ms">
          <p class="textSmall muted">Passive</p>
          <p class="textH4">Gravity, convection and a very large pool of water keep the core cool with no pumps, power or people.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="grid">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={4} />
          <h2 class="textH3 reveal">Hadron on the grid</h2>
        </div>
        <div class="prose reveal">
          <p>
            Understanding the energy grid and the role of diverse sources, including nuclear and renewables like solar,
            wind and hydro, is key to grasping the dynamics of our clean energy future. A Hadron plant behaves less like
            a traditional baseload station and more like a fleet of dispatchable units.
          </p>
          <p>
            Each module ramps between 20 and 100 percent of rated output at 5 percent per minute, and operators can take
            modules offline independently for refueling. On a representative western grid with 60 percent wind and
            solar, our modeling shows a six-module Hadron plant displacing 1.1 GW of gas peaking capacity and 2.4 GWh of
            battery storage while reducing total system cost by 9 percent.
          </p>
        </div>
      </div>

      <div class="chart reveal">
        <div class="chart__head">
          <p class="textSmall muted">Representative week — 480 MWe Hadron plant on a 60% renewable grid</p>
          <ul class="chart__legend textSmall">
            <li><i style="background:#4f7df9"></i>Hadron output</li>
            <li><i style="background:#2a2a2e"></i>Demand</li>
            <li><i style="background:#c9c9cc"></i>Wind + solar</li>
          </ul>
        </div>
        <svg class="chart__svg" viewBox="0 0 1200 360" fill="none" aria-hidden="true">
          <g stroke="#e0e0e0">
            <path d="M0 60h1200M0 150h1200M0 240h1200M0 330h1200" />
          </g>
          <path d="M0 150 C100 170 150 60 250 70 S400 230 500 200 650 60 750 80 900 240 1000 220 1150 80 1200 100V330H0Z" fill="#e8e8ea" />
          <path d="M0 110 C100 90 150 130 250 120 S400 70 500 80 650 130 750 110 900 70 1000 90 1150 120 1200 110" stroke="#2a2a2e" stroke-width="1.6" />
          <path d="M0 290 C100 280 150 320 250 318 S400 250 500 270 650 320 750 316 900 240 1000 250 1150 320 1200 318" stroke="#4f7df9" stroke-width="2.2" />
          <g fill="#8f8f92" font-size="12" font-family="Instrument Sans, sans-serif">
            <text x="0" y="352">Mon</text><text x="171" y="352">Tue</text><text x="343" y="352">Wed</text><text x="514" y="352">Thu</text><text x="686" y="352">Fri</text><text x="857" y="352">Sat</text><text x="1029" y="352">Sun</text>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={5} />
          <h2 class="textH3 reveal">Safety at Quark</h2>
        </div>
        <div class="prose reveal">
          <p>
            The Hadron reactor, leveraging natural forces and a deliberately simple design, offers unparalleled safety
            through every mode of operation.
          </p>
          <h3 class="textH4">The advantages of Hadron over traditional designs</h3>
          <p>
            Hadron modules sit below grade in a steel-lined concrete pool holding 30 million liters of water. In any
            upset, decay heat flows from the vessel to the pool by conduction and natural convection; the pool alone can
            absorb that heat for an unlimited period without make-up water, electricity or operator action. There are no
            large pipes connected to the vessel, so the largest possible break is small enough to be handled by passive
            systems alone.
          </p>
          <p>
            Additionally, the design allows for separation and "decoupling" of the turbine island from the nuclear
            island, ensuring the power conversion and heat delivery systems are completely separated from the nuclear
            portion of the plant. Non-nuclear teams can operate the steam turbines and heat-delivery systems outside the
            nuclear control area. This is safer and reduces costs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section factSheet" id="fact-sheet">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={6} />
          <h2 class="textH2 reveal">Hadron fact sheet</h2>
          <p class="muted reveal" style="--delay:100ms">Reference design values for the Hadron demonstration plant. Subject to change through licensing.</p>
        </div>
        <div class="factSheet__table reveal">
          <div class="rows">
            {
              specs.map(([k, v]) => (
                <div class="row">
                  <p class="row__label">{k}</p>
                  <p>{v}</p>
                </div>
              ))
            }
          </div>
          <div class="factSheet__actions">
            <a class="btnMain btnMain--solid" href="/contact">
              Request the full technical brief
              <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-arrow-top-right" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hadron__hero {
    aspect-ratio: 16 / 7;
    display: grid;
    place-items: center;
    min-height: 32rem;
  }

  .hadron__cutaway {
    position: relative;
    z-index: 1;
    width: 92%;
    height: auto;
    fill: none;
  }

  .pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem 1.6rem;
    margin-top: 8rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .pillars li {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  @media (min-width: 900px) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .chart {
    margin-top: 8rem;
    padding: 2.4rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }

  .chart__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.6rem;
    margin-bottom: 2.4rem;
  }

  .chart__legend {
    display: flex;
    gap: 2rem;
  }

  .chart__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .chart__legend i {
    width: 1.6rem;
    height: 0.3rem;
    border-radius: 2px;
  }

  .chart__svg {
    width: 100%;
    height: auto;
    fill: none;
  }

  .factSheet {
    padding-top: 0;
  }

  .factSheet__table {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .factSheet__table {
      grid-column: 4 / span 9;
    }
  }

  .factSheet__actions {
    margin-top: 4rem;
  }
</style>
