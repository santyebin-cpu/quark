---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
---

<Layout title="Page not found" description="The page you were looking for could not be found." dark>
  <section class="nf onDark" data-dark>
    <HeroCanvas />
    <div class="nf__inner maxWidth">
      <p class="textSmall muted">404</p>
      <h1 class="textXL">Not <span>found</span></h1>
      <p class="textH4 muted">The page you were looking for has decayed into something else.</p>
      <a class="btnMain" href={withBase('/')}>
        Back to the homepage
        <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  .nf {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
  }

  .nf__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 2.4rem;
    min-height: 100svh;
    padding: calc(var(--nav-h) + 4rem) 0 6rem;
  }

  .nf h1 span {
    color: var(--color-grey-on-black);
  }
</style>
