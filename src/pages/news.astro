---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { news, formatDate } from '../data/news';
import { site } from '../data/site';
---

<Layout title="News" description="Milestones, explainers and policy news from Qark Energy and India's nuclear sector.">
  <PageHero eyebrow="News" title="Newsroom" intro="Milestones on Qark One, explainers on thorium, and the policy news that shapes nuclear power in India." />

  <section class="section pad-top-0">
    <div class="maxWidth">
      <ol class="newsList">
        {
          news.map((item) => (
            <li class="newsItem reveal">
              <a class="newsItem__link" href={withBase(item.href)}>
                <div class="newsItem__meta">
                  <time class="textSmall newsItem__date" datetime={item.date}>
                    {formatDate(item.date)}
                  </time>
                  <span class="textSmall newsItem__tag">{item.tag}</span>
                </div>
                <div class="newsItem__body">
                  <h2 class="textH3">{item.title}</h2>
                  <p class="newsItem__summary">{item.summary}</p>
                </div>
                <svg class="newsItem__arrow" aria-hidden="true">
                  <use href="#icon-arrow-top-right" />
                </svg>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="newsCta">
        <p class="textH4">Media inquiries</p>
        <p class="newsCta__text">Journalists can reach us at <a class="linkArrow" href={`mailto:${site.email.media}`}>{site.email.media}</a>.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .newsList {
    border-top: 1px solid var(--color-line);
  }

  .newsItem {
    border-bottom: 1px solid var(--color-line);
  }

  .newsItem__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.6rem;
    padding: 3rem 0;
    transition: transform 0.4s var(--ease-out);
  }

  @media (min-width: 900px) {
    .newsItem__link {
      grid-template-columns: 3fr 8fr 1fr;
      padding: 4rem 0;
    }
  }

  .newsItem__date,
  .newsItem__summary,
  .newsCta__text {
    color: var(--color-text-muted);
  }

  .newsItem__meta {
    grid-column: 1 / -1;
    display: flex;
    gap: 1.6rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .newsItem__meta {
      grid-column: 1;
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .newsItem__tag {
    color: var(--color-accent-deep);
  }

  .newsItem__body {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 72rem;
  }

  .newsItem__arrow {
    width: 1.6rem;
    height: 1.6rem;
    justify-self: end;
    transition: transform 0.4s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .newsItem__link:hover {
      transform: translateX(1.2rem);
    }
    .newsItem__link:hover .newsItem__arrow {
      transform: translate(0.3rem, -0.3rem);
    }
  }

  .newsCta {
    margin-top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
