---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { news, formatDate } from '../data/news';
---

<Layout title="News" description="Press releases, milestones and coverage of Quark and the Hadron small modular reactor.">
  <PageHero eyebrow="News" title="Newsroom" intro="Press releases, project milestones and coverage of Quark and the Hadron plant." />

  <section class="section pad-top-0">
    <div class="maxWidth">
      <ol class="newsList">
        {
          news.map((item) => (
            <li class="newsItem reveal">
              <a class="newsItem__link" href={`/contact?subject=${encodeURIComponent(item.title)}`}>
                <div class="newsItem__meta">
                  <time class="textSmall muted" datetime={item.date}>
                    {formatDate(item.date)}
                  </time>
                  <span class="textSmall newsItem__tag">{item.tag}</span>
                </div>
                <div class="newsItem__body">
                  <h2 class="textH3">{item.title}</h2>
                  <p class="muted">{item.summary}</p>
                </div>
                <svg class="newsItem__arrow" aria-hidden="true">
                  <use href="#icon-arrow-top-right" />
                </svg>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="newsCta">
        <p class="textH4">Media inquiries</p>
        <p class="muted">Journalists can reach the communications team at <a class="linkArrow" href="mailto:press@quark.energy">press@quark.energy</a>.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .newsList {
    border-top: 1px solid var(--color-line);
  }

  .newsItem {
    border-bottom: 1px solid var(--color-line);
  }

  .newsItem__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.6rem;
    padding: 3rem 0;
    transition: padding-left 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (min-width: 900px) {
    .newsItem__link {
      grid-template-columns: 3fr 8fr 1fr;
      padding: 4rem 0;
    }
  }

  .newsItem__link:hover {
    padding-left: 1.2rem;
  }

  .newsItem__meta {
    grid-column: 1 / -1;
    display: flex;
    gap: 1.6rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .newsItem__meta {
      grid-column: 1;
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .newsItem__tag {
    color: var(--color-accent-deep);
  }

  .newsItem__body {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 72rem;
  }

  .newsItem__arrow {
    width: 1.6rem;
    height: 1.6rem;
    justify-self: end;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .newsItem__link:hover .newsItem__arrow {
    transform: translate(0.3rem, -0.3rem);
  }

  .newsCta {
    margin-top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
