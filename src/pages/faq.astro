---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionNumber from '../components/SectionNumber.astro';
import { faq } from '../data/faq';
---

<Layout title="Hadron FAQ" description="Frequently asked questions about the Hadron small modular reactor, the Idaho plant and Quark.">
  <PageHero eyebrow="Hadron FAQ" title="Frequently asked<br />questions" intro="Straight answers about small modular reactors, the Hadron plant and how Quark works." />

  {
    faq.map((group, gi) => (
      <section class="section pad-top-0">
        <div class="maxWidth">
          <div class="grid">
            <div class="side">
              <SectionNumber n={gi + 2} />
              <h2 class="textH3 reveal">{group.group}</h2>
            </div>
            <div class="faqList reveal">
              {group.items.map((item) => (
                <details class="faq">
                  <summary class="faq__q">
                    <span class="textH4">{item.q}</span>
                    <svg class="faq__icon" aria-hidden="true">
                      <use href="#icon-plus" />
                    </svg>
                  </summary>
                  <div class="faq__a">
                    <p>{item.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section pad-top-0">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={faq.length + 2} />
          <h2 class="textH3 reveal">Still curious?</h2>
        </div>
        <div class="prose reveal">
          <p>Our team answers questions from communities, customers and students every week.</p>
          <div class="pageHero__actions">
            <a class="btnMain btnMain--solid" href="/contact">
              Ask a question
              <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-arrow-top-right" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .faqList {
    grid-column: 1 / -1;
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 900px) {
    .faqList {
      grid-column: 4 / span 8;
    }
  }

  .faq {
    border-bottom: 1px solid var(--color-line);
  }

  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    padding: 2.4rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), background 0.3s ease, color 0.3s ease;
  }

  .faq__q:hover .faq__icon {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .faq[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__a {
    padding: 0 0 2.8rem;
    max-width: 64rem;
    color: var(--color-grey-on-white);
  }
</style>
