---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionNumber from '../components/SectionNumber.astro';
import { faq } from '../data/faq';
---

<Layout title="FAQ" description="Frequently asked questions about Qark One, thorium fuel, safety and Qark Energy.">
  <PageHero eyebrow="FAQ" title="Frequently asked<br />questions" intro="Straight answers about Qark One, thorium and how we work." />

  {
    faq.map((group, gi) => (
      <section class="section pad-top-0">
        <div class="maxWidth">
          <div class="grid">
            <div class="side">
              <SectionNumber n={gi + 2} />
              <h2 class="textH3 reveal">{group.group}</h2>
            </div>
            <div class="faqList reveal">
              {group.items.map((item) => (
                <details class="faq">
                  <summary class="faq__q">
                    <span class="textH4">{item.q}</span>
                    <svg class="faq__icon" aria-hidden="true">
                      <use href="#icon-plus" />
                    </svg>
                  </summary>
                  <div class="faq__a">
                    <p>{item.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section pad-top-0">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={faq.length + 2} />
          <h2 class="textH3 reveal">Still curious?</h2>
        </div>
        <div class="prose reveal">
          <p>If your question is not answered here, ask us directly.</p>
          <div class="pageHero__actions">
            <a class="btnMain btnMain--solid" href={withBase('/contact')}>
              Ask a question
              <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-arrow-top-right" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .faqList {
    grid-column: 1 / -1;
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 900px) {
    .faqList {
      grid-column: 4 / span 8;
    }
  }

  .faq {
    border-bottom: 1px solid var(--color-line);
  }

  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    padding: 2.4rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    transition:
      transform 0.4s var(--ease-out),
      background-color 0.3s ease,
      color 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq__q:hover .faq__icon {
      background: var(--color-ink);
      color: var(--color-white);
    }
  }

  .faq[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__a {
    padding: 0 0 2.8rem;
    max-width: 64rem;
    color: var(--color-text-muted);
  }
</style>
