---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionNumber from '../components/SectionNumber.astro';
import { site } from '../data/site';

// Each topic routes to the team that answers it; ?topic=<value> preselects one.
const topics = [
  { value: 'power', label: 'Buying power or steam', email: site.email.general },
  { value: 'partners', label: 'Partnerships and sites', email: site.email.partners },
  { value: 'investors', label: 'Investment', email: site.email.investors },
  { value: 'suppliers', label: 'Supplier registration', email: site.email.suppliers },
  { value: 'careers', label: 'Careers', email: site.email.careers },
  { value: 'media', label: 'Media', email: site.email.media },
  { value: 'general', label: 'Something else', email: site.email.general },
];

const lines = [
  ['General', site.email.general],
  ['Partnerships and sites', site.email.partners],
  ['Investors', site.email.investors],
  ['Suppliers', site.email.suppliers],
  ['Careers', site.email.careers],
  ['Media', site.email.media],
];
---

<Layout
  title="Contact"
  description="Contact Qark Energy about buying power or steam, partnerships, investment, supplying Qark One, careers or media."
>
  <PageHero
    eyebrow="Contact"
    title="Get in touch"
    intro="Utilities, industry, government, investors, suppliers and engineers: tell us what you need and we will route it to the right people."
  />

  <section class="section pad-top-0">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={2} />
          <h2 class="textH3 reveal">Send a message</h2>
          <p class="contact__how reveal" style="--delay:100ms">
            Sending opens your email app with the message addressed to the right team.
          </p>
        </div>
        <form class="form reveal" method="post" action="#" data-contact-form novalidate>
          <div class="form__grid">
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="org">Organisation</label>
              <input id="org" name="organisation" type="text" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="topic">Topic</label>
              <select id="topic" name="topic">
                {topics.map((t) => <option value={t.value} data-email={t.email}>{t.label}</option>)}
              </select>
            </div>
            <div class="field field--full">
              <label for="subject">Subject</label>
              <input id="subject" name="subject" type="text" />
            </div>
            <div class="field field--full">
              <label for="message">Message</label>
              <textarea id="message" name="message" required></textarea>
            </div>
          </div>
          <div class="form__actions">
            <button class="btnMain btnMain--solid" type="submit">
              Write the email
              <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-arrow-top-right" /></svg>
            </button>
            <p class="textSmall form__privacy">
              See our <a href={withBase('/privacy')}>privacy policy</a>.
            </p>
          </div>
          <p class="form__status" role="status" aria-live="polite" data-form-status></p>
        </form>
      </div>
    </div>
  </section>

  <section class="section onDark darkBlock" data-dark>
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={3} />
          <h2 class="textH3 reveal">Direct lines</h2>
        </div>
        <div class="contact__lines reveal">
          <div class="rows">
            {
              lines.map(([k, v]) => (
                <div class="row">
                  <p class="row__label">{k}</p>
                  <p>
                    <a class="linkArrow" href={`mailto:${v}`}>
                      {v}
                    </a>
                  </p>
                </div>
              ))
            }
            <div class="row">
              <p class="row__label">Office</p>
              <p>{[site.legalName, ...site.address].join(', ')}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact__how {
    color: var(--color-text-muted);
    max-width: 28rem;
  }

  .form {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .form {
      grid-column: 4 / span 8;
    }
  }

  .form__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem 1.6rem;
  }

  @media (min-width: 700px) {
    .form__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .field--full {
      grid-column: 1 / -1;
    }
  }

  .form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
    margin-top: 4rem;
  }

  .form__privacy {
    color: var(--color-text-muted);
  }

  .form__privacy a {
    text-decoration: underline;
  }

  .form__status {
    margin-top: 2rem;
    color: var(--color-accent-deep);
    min-height: 1.5em;
  }

  .contact__lines {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .contact__lines {
      grid-column: 4 / span 9;
    }
  }

  .contact__lines .rows,
  .contact__lines :global(.row) {
    border-color: rgba(255, 255, 255, 0.15);
  }

  .contact__lines :global(.row__label) {
    color: var(--color-grey-on-black);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const topic = document.getElementById('topic') as HTMLSelectElement | null;

  // Pre-fill from links elsewhere on the site: ?topic=, ?subject= and the footer's ?email=.
  const params = new URLSearchParams(window.location.search);
  const presetTopic = params.get('topic');
  const subject = params.get('subject');
  const email = params.get('email');
  if (topic && presetTopic && [...topic.options].some((o) => o.value === presetTopic)) topic.value = presetTopic;
  if (subject) (document.getElementById('subject') as HTMLInputElement | null)?.setAttribute('value', subject);
  if (email) (document.getElementById('email') as HTMLInputElement | null)?.setAttribute('value', email);

  // There is no form backend yet: compose the message in the visitor's own email app instead.
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const data = new FormData(form);
    const option = topic?.selectedOptions[0];
    const to = option?.dataset.email ?? '';
    const topicLabel = option?.textContent ?? 'Enquiry';
    const subjectLine = String(data.get('subject') || '').trim() || topicLabel;
    const body = [
      String(data.get('message') || '').trim(),
      '',
      `${data.get('name')}${data.get('organisation') ? `, ${data.get('organisation')}` : ''}`,
      String(data.get('email') || ''),
    ].join('\n');
    window.location.href = `mailto:${to}?subject=${encodeURIComponent(`[${topicLabel}] ${subjectLine}`)}&body=${encodeURIComponent(body)}`;
    if (status) status.textContent = `Your email app should open with the message addressed to ${to}. If it does not, write to that address directly.`;
  });
</script>
