---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionNumber from '../components/SectionNumber.astro';
import Render from '../components/Render.astro';
import factoryHall from '../assets/plant/factory-hall.jpg';

const principles = [
  {
    title: 'Physics before machinery',
    text: 'Gravity, natural circulation and large pools of water keep Qark One safe, so its safety does not depend on pumps, power or people.',
  },
  {
    title: 'Built in India',
    text: 'We design for components that Indian industry can make, and for sites and grids that India already has.',
  },
  {
    title: 'Only what is true',
    text: 'We publish our reference data and say plainly where the design stands. Concept means concept.',
  },
  {
    title: 'Part of a national effort',
    text: 'India’s nuclear institutions have worked towards thorium for seventy years. We aim to work alongside them.',
  },
];

const disciplines = [
  'Reactor physics',
  'Thermal-hydraulics',
  'Fuel design',
  'Mechanical and structural design',
  'Safety analysis and licensing',
  'Manufacturing and supply chain',
];
---

<Layout
  title="About"
  description="Qark Energy is developing Qark One, a thorium-fuelled small modular reactor, to bring more firm, carbon-free power to India."
>
  <PageHero
    eyebrow="About"
    title="About Qark Energy"
    intro="Qark Energy is developing Qark One, a thorium-fuelled small modular reactor, to bring more firm, carbon-free power to India."
  />

  <section class="section pad-top-0">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={2} />
          <h2 class="textH3 reveal">Why we exist</h2>
        </div>
        <div class="prose reveal">
          <p>
            India will need far more electricity in the coming decades, and much of it has to be firm: available at
            night, in the monsoon and through every season. Nuclear power can supply it without burning fuel, and India
            has set out to expand it to 100 GW by 2047.
          </p>
          <p>
            The country also holds one of the world’s largest reserves of thorium. We started Qark Energy to put that
            resource to work in a reactor that can be built quickly, run safely and made with Indian industry.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section onDark darkBlock" data-dark>
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={3} />
          <h2 class="textH3 reveal">How we work</h2>
        </div>
        <ul class="ab__principles">
          {
            principles.map((p, i) => (
              <li class="reveal" style={`--delay:${(i % 2) * 90}ms`}>
                <h3 class="textH4">{p.title}</h3>
                <p class="ab__principleText">{p.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={4} />
          <h2 class="textH3 reveal">The work</h2>
        </div>
        <div class="prose reveal">
          <p>
            Designing a reactor takes many disciplines working as one. Ours span the core, the fuel, the plant around
            them and the case that shows it is safe, and we are growing in each of them.
          </p>
          <ul class="ab__disciplines">
            {disciplines.map((d) => <li>{d}</li>)}
          </ul>
          <div class="pageHero__actions">
            <a class="btnMain btnMain--solid" href={withBase('/careers')}>
              Join the team
              <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-arrow-top-right" /></svg>
            </a>
            <a class="btnMain" href={withBase('/contact')}>
              Get in touch
              <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-plus" /></svg>
            </a>
          </div>
        </div>
      </div>
      <Render
        src={factoryHall}
        alt="Concept render of a factory hall where large reactor components are fabricated"
        class="ab__render"
        sizes="100vw"
      />
    </div>
  </section>
</Layout>

<style>
  .ab__principles {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 1.6rem;
  }

  @media (min-width: 700px) {
    .ab__principles {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .ab__principles {
      grid-column: 4 / span 9;
    }
  }

  .ab__principles li {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 2.4rem 0 3.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .ab__principleText {
    color: var(--color-grey-on-black);
  }

  .ab__disciplines {
    border-top: 1px solid var(--color-line);
  }

  .ab__disciplines li {
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .maxWidth :global(.ab__render) {
    margin-top: 8rem;
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 900px) {
    .maxWidth :global(.ab__render) {
      aspect-ratio: 21 / 9;
    }
  }
</style>
