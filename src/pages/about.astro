---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionNumber from '../components/SectionNumber.astro';
import { board, leadership } from '../data/team';

const bios = [...board, ...leadership].filter((p, i, arr) => p.bio && arr.findIndex((x) => x.name === p.name) === i);
---

<Layout
  title="About"
  description="Quark's innovators create small modular reactors to provide safe, affordable and abundant carbon-free energy and heat."
>
  <PageHero
    eyebrow="About"
    title="About Quark"
    intro="Quark's innovators create technologies to provide safe, affordable and abundant carbon-free energy. They devise ways to use heat and electricity to drive economic growth while decarbonizing industry. And they build the factories that will make nuclear plants a product rather than a project."
  />

  <section class="section pad-top-0">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={2} />
          <h2 class="textH3 reveal">Unparalleled technical and engineering expertise</h2>
        </div>
        <div class="prose reveal">
          <p>
            Our team combines deep technical and engineering expertise, experience delivering nuclear projects, and a
            track record of building organizations that tackle large-scale global challenges. Quark was founded in 2016
            by a reactor physicist and an infrastructure investor who agreed on one thing: nuclear power would only
            scale again if plants became small enough to build in a factory and simple enough to be safe without
            intervention.
          </p>
          <p>
            Advanced manufacturing, modern simulation and a regulatory framework for advanced reactors have made that
            possible in ways that were unimaginable a few decades ago. At Quark, we are innovating in nuclear to improve
            the lives of people everywhere and to build the clean energy of tomorrow — today.
          </p>
        </div>
      </div>

      <ul class="figures">
        <li class="reveal"><p class="textH1">2016</p><p class="muted">Founded</p></li>
        <li class="reveal" style="--delay:80ms"><p class="textH1">640</p><p class="muted">Employees across four offices</p></li>
        <li class="reveal" style="--delay:160ms"><p class="textH1">480<span class="muted"> MWe</span></p><p class="muted">Under construction in Idaho</p></li>
        <li class="reveal" style="--delay:240ms"><p class="textH1">3.2<span class="muted"> GWe</span></p><p class="muted">Contracted and optioned pipeline</p></li>
      </ul>
    </div>
  </section>

  <section class="section onDark darkBlock" data-dark>
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={3} />
          <h2 class="textH3 reveal">Quark board</h2>
        </div>
        <ul class="people">
          {
            board.map((p, i) => (
              <li class="reveal" style={`--delay:${(i % 3) * 70}ms`}>
                <h3 class="textH4">{p.name}</h3>
                <p class="muted">{p.role}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={4} />
          <h2 class="textH3 reveal">Leadership team</h2>
        </div>
        <ul class="people people--light">
          {
            leadership.map((p, i) => (
              <li class="reveal" style={`--delay:${(i % 3) * 70}ms`}>
                <h3 class="textH4">{p.name}</h3>
                <p class="muted">{p.role}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section pad-top-0">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={5} />
          <h2 class="textH3 reveal">Biographies</h2>
        </div>
        <div class="prose">
          {
            bios.map((p) => (
              <article class="bio reveal">
                <h3 class="textH4">{p.name}</h3>
                <p class="textSmall muted">{p.role}</p>
                <p>{p.bio}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .figures {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 1.6rem;
    margin-top: 8rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 900px) {
    .figures {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .figures li {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .people {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 1.6rem;
  }

  @media (min-width: 600px) {
    .people {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .people {
      grid-column: 4 / span 9;
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .people li {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 2rem 0 2.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .people--light li {
    border-top-color: var(--color-line);
  }

  .bio {
    padding: 3rem 0;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .bio + .bio {
    margin-top: 0;
  }

  .bio p:last-child {
    margin-top: 1rem;
  }
</style>
