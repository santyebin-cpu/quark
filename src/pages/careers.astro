---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionNumber from '../components/SectionNumber.astro';
import { site } from '../data/site';

const values = [
  {
    title: 'Safety is the design',
    body: 'Every decision starts from the safety case. We never trade it for speed.',
  },
  {
    title: 'Show your work',
    body: 'Analyses are reproducible, assumptions are written down, and anyone can ask why.',
  },
  {
    title: 'Build in India',
    body: 'We design for Indian industry, Indian sites and the people who will run these plants for decades.',
  },
  {
    title: 'Shape it early',
    body: 'Qark One is at concept stage. The people who join now decide what it becomes.',
  },
];

const disciplines = [
  { title: 'Reactor physics', area: 'Core and fuel' },
  { title: 'Thermal-hydraulics', area: 'Natural circulation and passive cooling' },
  { title: 'Fuel design and materials', area: 'Thorium–HALEU fuel' },
  { title: 'Mechanical and structural design', area: 'Reactor block and plant' },
  { title: 'Safety analysis and licensing', area: 'Safety case' },
  { title: 'Instrumentation and control', area: 'Shutdown and control systems' },
  { title: 'Manufacturing and supply chain', area: 'Indian industry' },
];
---

<Layout
  title="Careers"
  description="Join Qark Energy and help design Qark One, India's thorium-fuelled small modular reactor."
>
  <PageHero
    eyebrow="Careers"
    title="Build India’s<br />thorium reactor"
    intro="We are a small team designing Qark One, and we are looking for engineers and scientists who want to put India’s thorium to work."
  >
    <div class="pageHero__actions">
      <a class="btnMain btnMain--solid" href="#roles">
        Disciplines we hire for
        <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-arrow-down" /></svg>
      </a>
    </div>
  </PageHero>

  <section class="section pad-top-0">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={2} />
          <h2 class="textH3 reveal">How we work</h2>
        </div>
        <ul class="values">
          {
            values.map((v, i) => (
              <li class="reveal" style={`--delay:${(i % 2) * 90}ms`}>
                <h3 class="textH4">{v.title}</h3>
                <p class="values__text">{v.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section onDark darkBlock" data-dark>
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={3} />
          <h2 class="textH3 reveal">What you would work on</h2>
        </div>
        <div class="prose reveal">
          <p class="textH4">
            At concept stage, every discipline shapes the design: the core and its thorium fuel, the natural-circulation
            loop, the passive safety systems, the plant around them and how it will be built in India.
          </p>
          <p>
            You would work from the reference data in drawing QE-GA-001 towards a design that India’s regulator can
            review and Indian industry can build.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="roles">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={4} />
          <h2 class="textH3 reveal">Disciplines we hire for</h2>
          <p class="roles__count reveal" style="--delay:100ms">Based in India</p>
        </div>
        <div class="roles">
          <ul class="rows">
            {
              disciplines.map((r) => (
                <li class="reveal">
                  <a
                    class="role row"
                    href={withBase(`/contact?topic=careers&subject=${encodeURIComponent('Application: ' + r.title)}`)}
                  >
                    <div class="role__meta">
                      <p class="role__area">{r.area}</p>
                    </div>
                    <div class="role__title">
                      <h3 class="textH4">{r.title}</h3>
                      <svg aria-hidden="true">
                        <use href="#icon-arrow-top-right" />
                      </svg>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="roles__note">
            Tell us which of these fits you, or what else you would bring. Send your CV to
            <a class="linkArrow" href={`mailto:${site.email.careers}`}>{site.email.careers}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .values {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 1.6rem;
  }

  @media (min-width: 700px) {
    .values {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .values {
      grid-column: 4 / span 9;
    }
  }

  .values li {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 2.4rem 0 3.2rem;
    border-top: 1px solid var(--color-line);
  }

  .values__text,
  .roles__count,
  .role__meta,
  .roles__note {
    color: var(--color-text-muted);
  }

  .roles {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .roles {
      grid-column: 4 / span 9;
    }
  }

  .role {
    transition: transform 0.4s var(--ease-out);
  }

  .role__meta {
    display: flex;
    gap: 1.6rem;
  }

  .role__title {
    display: flex;
    justify-content: space-between;
    gap: 1.6rem;
  }

  .role__title svg {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.3rem;
    transition: transform 0.4s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .role:hover {
      transform: translateX(1.2rem);
    }
    .role:hover .role__title svg {
      transform: translate(0.3rem, -0.3rem);
    }
  }

  .roles__note {
    margin-top: 3rem;
  }
</style>
