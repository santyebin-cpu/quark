---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionNumber from '../components/SectionNumber.astro';
import { site } from '../data/site';

const categories = [
  ['Heavy forgings and vessels', 'The calandria, end shields, steam drums and other large pressure-retaining parts.'],
  ['Pressure tubes and channel parts', 'Zirconium-alloy pressure tubes, end fittings and the hardware of the 452 fuel channels.'],
  ['Piping and valves', 'Large-bore piping for the natural-circulation loop, safety valves and balance-of-plant equipment.'],
  ['Fuel handling', 'Fuelling machines and handling equipment for on-power, top-entry refuelling.'],
  ['Instrumentation and control', 'Safety-grade instrumentation, both shutdown systems and control-room equipment.'],
  ['Turbine island', 'Turbine-generators, condensers, feedwater and electrical systems.'],
  ['Civil, structural and cranes', 'The reactor building, its pools, heavy cranes and site construction.'],
  ['Engineering services', 'Analysis, design, licensing support and training.'],
];

const steps = [
  ['Register interest', 'Tell us what you make, the codes you work to and the certifications you hold.'],
  ['Capability review', 'We review your capabilities against the parts of the plant you could supply.'],
  ['Design for manufacture', 'Promising suppliers help shape parts of the design so they can be built well in India.'],
  ['Qualify and bid', 'When procurement begins, suppliers are formally qualified and invited to bid.'],
];
---

<Layout
  title="Suppliers"
  description="Work with Qark Energy as a supplier of forgings, channel components, equipment and services for Qark One plants in India."
>
  <PageHero
    eyebrow="Suppliers"
    title="Build with us"
    intro="Qark One is designed to be built with Indian industry. We want to hear from manufacturers and service firms that could supply the plant as the design develops."
  >
    <div class="pageHero__actions">
      <a class="btnMain btnMain--solid" href={withBase('/contact?topic=suppliers')}>
        Register your interest
        <svg class="btnMain__icon" aria-hidden="true"><use href="#icon-arrow-top-right" /></svg>
      </a>
    </div>
  </PageHero>

  <section class="section pad-top-0">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={2} />
          <h2 class="textH3 reveal">What a plant needs</h2>
        </div>
        <div class="supplierTable reveal">
          <div class="rows">
            {
              categories.map(([k, v]) => (
                <div class="row">
                  <p class="textH4">{k}</p>
                  <p class="supplierTable__text">{v}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section onDark darkBlock" data-dark>
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={3} />
          <h2 class="textH3 reveal">How to work with us</h2>
        </div>
        <ol class="steps">
          {
            steps.map(([k, v], i) => (
              <li class="reveal" style={`--delay:${i * 80}ms`}>
                <p class="textSmall steps__n tabular">Step {i + 1}</p>
                <h3 class="textH4">{k}</h3>
                <p class="steps__text">{v}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="maxWidth">
      <div class="grid">
        <div class="side">
          <SectionNumber n={4} />
          <h2 class="textH3 reveal">What to expect</h2>
        </div>
        <div class="prose reveal">
          <p>
            Qark One is at concept stage, so we are not buying hardware yet. We are building a list of capable
            suppliers to involve as the design develops, and we would rather hear from you early.
          </p>
          <p>
            Suppliers of safety-related parts will need a quality-assurance programme that meets the nuclear standards
            that apply in India, and every supplier will be expected to work to a code of conduct covering ethics,
            labour practices and security.
          </p>
          <p>
            Questions can be sent to <a class="linkArrow" href={`mailto:${site.email.suppliers}`}>{site.email.suppliers}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .supplierTable {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .supplierTable {
      grid-column: 4 / span 9;
    }
  }

  .supplierTable__text {
    color: var(--color-text-muted);
  }

  .steps {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 1.6rem;
  }

  @media (min-width: 700px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .steps {
      grid-column: 4 / span 9;
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .steps li {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 2.4rem 0 3.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .steps__n,
  .steps__text {
    color: var(--color-grey-on-black);
  }
</style>
