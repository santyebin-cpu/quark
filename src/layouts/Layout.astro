---
import { withBase } from '../lib/paths';
import '../styles/global.css';
import Icons from '../components/Icons.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import shareImage from '../assets/plant/plant-cutaway.jpg';

interface Props {
  title: string;
  description?: string;
  /** Hero starts dark; nav renders in its inverted state immediately. */
  dark?: boolean;
}

const { title, description = site.description, dark = false } = Astro.props;
// The home title leads with the brand and the plain-language product, which is what people search for.
const fullTitle = title === site.name ? `${site.name} | Thorium Small Modular Reactor for India` : `${title} | ${site.name}`;
const ogImage = await getImage({ src: shareImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = new URL(cleanPath, Astro.site);
const isHome = cleanPath === '/';

// Structured data so search engines can show the brand name, logo and site name.
// Add `sameAs` profile URLs here once the real LinkedIn/X pages exist.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', Astro.site).href,
  name: site.name,
  legalName: site.legalName,
  url: new URL('/', Astro.site).href,
  logo: new URL('/icon-512.png', Astro.site).href,
  description: site.description,
  email: site.email.general,
  areaServed: site.country,
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  name: site.name,
  alternateName: [site.shortName, site.product],
  url: new URL('/', Astro.site).href,
  publisher: { '@id': organization['@id'] },
};
const jsonLd = isHome ? [organization, website] : [organization];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-48.png')} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Concept render of a Qark One plant in cutaway" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content={dark ? '#000000' : '#ffffff'} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        // Full motion for every visitor by default (owner's decision; the OS "reduce motion" setting is not followed).
        // ?motion=reduced switches to the still version for this tab, ?motion=full switches back.
        var mode = new URLSearchParams(location.search).get('motion');
        try {
          if (mode) sessionStorage.setItem('qark-motion', mode);
          mode = sessionStorage.getItem('qark-motion');
        } catch (e) {}
        var reduced = mode === 'reduced';
        if (reduced) root.classList.add('motion-reduced');
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={{ 'is-dark-start': dark }}>
    <Icons />
    <a class="skip sr-only" href="#main">Skip to content</a>
    <Nav dark={dark} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <script>
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      const reduced = document.documentElement.classList.contains('motion-reduced');

      // Inertial smooth scrolling. It drives native scroll, so sticky and scroll listeners keep working.
      // autoToggle pauses it whenever <html> gets overflow: hidden (e.g. the open menu).
      if (!reduced) {
        new Lenis({ autoRaf: true, anchors: true, autoToggle: true, lerp: 0.085 });
      }

      // Scroll-reveal: text fades up, headline lines slide out of their masks, photos unclip.
      const items = document.querySelectorAll<HTMLElement>('.reveal, .lines, [data-reveal-media]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }

      // Parallax: --pp runs 0 → 1 while an element crosses the viewport.
      const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');
      if (!reduced && parallaxEls.length && 'IntersectionObserver' in window) {
        const active = new Set<HTMLElement>();
        let queued = false;
        const update = () => {
          queued = false;
          const vh = window.innerHeight;
          for (const el of active) {
            const r = el.getBoundingClientRect();
            const pp = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
            el.style.setProperty('--pp', pp.toFixed(4));
          }
        };
        const queue = () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(update);
          }
        };
        const pio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) active.add(e.target as HTMLElement);
              else active.delete(e.target as HTMLElement);
            }
            queue();
          },
          { rootMargin: '25% 0px' },
        );
        parallaxEls.forEach((el) => pio.observe(el));
        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue);
      }
    </script>
  </body>
</html>

<style is:global>
  .skip:focus {
    position: fixed;
    top: 1rem;
    left: 1rem;
    width: auto;
    height: auto;
    margin: 0;
    padding: 1rem 1.4rem;
    clip: auto;
    background: var(--color-white);
    color: var(--color-ink);
    border-radius: 999px;
    z-index: 200;
  }
</style>
